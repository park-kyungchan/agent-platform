{
  "name": "@palantirkc/agent-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:handoff": "bun test ./compatibility/codex-harness-engineering/tests/handoff.test.ts",
    "check:imports": "bun ./verification/package-import-check.ts",
    "check:operational-context": "bun test ./packages/operational-context/lead-evaluation.test.ts",
    "check:source": "bun ci/source-check.ts",
    "check:quality": "bun ci/quality/run.ts all",
    "check:format": "bun ci/quality/run.ts format",
    "format": "bun ci/quality/run.ts format:write",
    "check:lint": "bun ci/quality/run.ts lint",
    "check:architecture": "bun ci/quality/run.ts architecture",
    "check:workflows": "bun ci/quality/run.ts workflows",
    "check:dependencies": "bun audit --audit-level=high",
    "harness": "bun scripts/harness.ts",
    "check:git-work": "bun test packages/work-continuity/src/git-work packages/work-continuity/src/runtime-docs",
    "check:common-work": "bun scripts/verify-common-work.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@palantirkc/work-continuity": "workspace:*",
    "@palantirkc/ontology": "file:releases/palantirkc-ontology-0.2.0.tgz",
    "@palantirkc/infrastructure-operations": "workspace:*",
    "@palantirkc/native-codex-adapter": "workspace:*",
    "@palantirkc/native-hermes-adapter": "workspace:*",
    "@palantirkc/operational-context": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
