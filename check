#!/usr/bin/env bash
# The one check of this repository. An agent runs it before a push; the CI job
# `rust` runs it unchanged. Outside CI, on the host that has the build lock, it
# takes that lock (one Cargo build at a time on the host) and refuses to build
# when the file system has less than 10,240 MiB free.
#   ./check          everything
#   ./check content  only the steps that need no Rust build (a change of content/ or documents)
#   ./check lint     the content steps, then rustfmt and clippy (the CI job `lint`)
#   ./check test     everything of ./check but the content steps, rustfmt and clippy (the CI job `test`)
set -euo pipefail
self=$(realpath "$0")
cd "$(dirname "$self")"
mode=${1:-all}
case "$mode" in
  all|content|lint|test) ;;
  *) echo "usage: ./check [all|content|lint|test]" >&2; exit 2 ;;
esac
# The declared skips (ci/skips.json, specs/ap/check.md R22): a step that cannot run here appends its row's id as one
# line to the file CHECK_SKIPS names, and the line `check: skipped <id> ...` before the last line names them. The file
# lies in a directory of its own, so that a step under sudo appends to it too (fs.protected_regular refuses root's
# append to another user's file in /tmp). The re-exec under the lock keeps the file of the first process, known by
# CHECK_SKIPS_KEEP, which it removes from its environment before its first step; any other ./check makes its own.
# Only a file of the form this script makes is kept, so the removal at the exit never takes another directory.
if [ -n "${CHECK_SKIPS_KEEP:-}" ] && [ "$CHECK_SKIPS_KEEP" = "${CHECK_SKIPS:-}" ] && [ -f "$CHECK_SKIPS" ] \
  && [[ "$(basename -- "$(dirname -- "$CHECK_SKIPS")")/$(basename -- "$CHECK_SKIPS")" == check-skips.*/ids.* ]]; then
  skips_dir=$(dirname -- "$CHECK_SKIPS")
else
  skips_dir=$(mktemp -d "${TMPDIR:-/tmp}/check-skips.XXXXXXXX")
  CHECK_SKIPS=$(mktemp "$skips_dir/ids.XXXXXXXX")
fi
unset CHECK_SKIPS_KEEP
export CHECK_SKIPS
trap 'rm -rf -- "$skips_dir"' EXIT
# The line of the skips, each id once in the order of its first line; nothing when no step skipped.
say_skips() {
  local ids
  ids=$(awk 'NF && !seen[$0]++' "$CHECK_SKIPS" | paste -sd ' ' -)
  if [ -n "$ids" ]; then echo "check: skipped $ids"; fi
}

if [ "$mode" != test ]; then
python3 -I -B ci/check-content.py
bash scripts/test-install-content.sh
bash scripts/test-pc-pull.sh
bash scripts/test-backup-store.sh
python3 -I -B -m unittest discover -s github -p 'test_*.py'
python3 -I -B ci/check-map.py crates/ ci/ content/ deploy/ evals/ github/ ontology/ scripts/ specs/ .github/ check rust-toolchain.toml Cargo.toml Cargo.lock
python3 -I -B ci/check-spec-trace.py
# The work schema declares no action type and no view that the code, the content and the host's scripts do not name.
python3 -I -B ci/check-schema-use.py
# Every skip site appends a declared id of ci/skips.json, and every declared id has its site.
python3 -I -B ci/skips.py declared
# Every ci/test_*.py in sorted order, but those that build their stores with the engine: each of these has a step
# of its own after the build.
after_build="test_lesson_replay.py test_intake_suite.py test_cases_engine.py"
for test in $(cd ci && printf '%s\n' test_*.py | LC_ALL=C sort); do
  case " $after_build " in *" $test "*) continue ;; esac
  python3 -I -B -m unittest discover -s ci -p "$test"
done
fi
if [ "$mode" = content ]; then say_skips; echo "check: ok (content)"; exit 0; fi

if [ "${CI:-}" != true ] && [ -z "${CHECK_LOCKED:-}" ]; then
  lock=${HOST_CARGO_LOCK:-/var/lib/agent-platform/build.lock}
  if [ -e "$lock" ]; then
    free=$(df -BM --output=avail . | tail -n 1 | tr -dc 0-9)
    if [ "$free" -lt 10240 ]; then
      echo "disk_floor@check: ${free} MiB free, 10240 needed" >&2
      exit 3
    fi
    export CHECK_LOCKED=1 CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
    export CHECK_SKIPS_KEEP="${CHECK_SKIPS:-}"
    export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" RUST_TEST_THREADS="${RUST_TEST_THREADS:-2}"
    exec flock "$lock" "$self" "$@"
  fi
fi

# The engine for the rehearsal and every step after it, chosen by ci/engine-pin.sh before the Rust build so that
# a missing engine refuses first. The rule of two trees (specs/ap/check.md R26): a tree that holds
# ontology/ENGINE-PIN takes the engine of the pin (deploy/README.md, "The engine of a pin"); one without it that
# holds engine/ takes the engine named by the Git tree id of engine/ (deploy/README.md, "An engine change"),
# and runs engine/check exactly when that engine had to be built here.
if [ -e ontology/ENGINE-PIN ] || [ -L ontology/ENGINE-PIN ]; then
  pin=$(tr -d '[:space:]' < ontology/ENGINE-PIN)
  [[ "$pin" =~ ^[0-9a-f]{40}$ ]] || { echo "engine_pin_invalid@ontology/ENGINE-PIN" >&2; exit 2; }
  ont_bin=$(bash ci/engine-pin.sh "$pin")
elif [ -d engine ]; then
  ont_bin=$(bash ci/engine-pin.sh --tree)
  engine_root=${CARGO_TARGET_DIR:-$PWD/target}/engine-tree
  if [ "$ont_bin" = "$engine_root/build/debug/ont" ]; then
    CARGO_TARGET_DIR="$engine_root/build" engine/check
  fi
else
  echo "engine_missing@check: the tree holds neither ontology/ENGINE-PIN nor engine/" >&2
  exit 2
fi
# The build of `ap` (clippy, test, the engine tests) generates its module of the schema with this engine
# (crates/ap/build.rs), so every step of the check uses the one.
export ONT_BIN="$ont_bin"

if [ "$mode" != lint ]; then bash scripts/test-install-ap.sh; fi
if [ "$mode" != test ]; then
  cargo fmt --all -- --check
  CARGO_BUILD_WARNINGS=deny cargo clippy --workspace --all-targets --locked
fi
if [ "$mode" = lint ]; then say_skips; echo "check: ok (lint)"; exit 0; fi
# The review tests need a private root that this check creates and removes.
AP_S03_TEST_ROOT=$(mktemp -d "$PWD/.ap-rust-test.XXXXXXXX")
export AP_S03_TEST_ROOT
chmod 0700 "$AP_S03_TEST_ROOT"
trap 'rm -rf -- "$skips_dir"; rmdir -- "$AP_S03_TEST_ROOT"' EXIT
cargo test --workspace --locked
# `ap run` against the real systemd: skipped, saying so, where systemctl is absent or this caller
# cannot start a transient unit in the system manager (the hosted runner is not root).
bash ci/host-run-scope.sh "${CARGO_TARGET_DIR:-$PWD/target}/debug/ap"

# The schema against a real engine: ontology/work.schema.json is installed into a
# disposable store of the engine chosen above (the pin's, or the tree's of engine/), and every action
# answer `ap` parses is asserted. The engine is the one chosen before the build (ci/engine-pin.sh).
# The engine admits only uid 0, so in CI the rehearsal runs through sudo. The index sources of the schema name
# the host's work directory; the rehearsal reads fixture files of the repository (ontology/fixtures/work) that it
# copies under its own temporary root, and makes nothing under /home/palantirkc/work.
if [ "${CI:-}" = true ] && [ "$(id -u)" != 0 ]; then
  sudo env "PATH=$PATH" "CHECK_SKIPS=$CHECK_SKIPS" GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory "GIT_CONFIG_VALUE_0=$PWD" \
    bash ontology/rehearsal.sh "$ont_bin" > /dev/null
else
  bash ontology/rehearsal.sh "$ont_bin" > /dev/null
fi
# The tests of `ap route`, `ap clause`, `ap resource`, `ap api`, `ap run` and `ap measure` that run the real engine (crates/ap/tests/route_engine.rs
# and the ignored tests of crates/ap/tests/clause.rs, crates/ap/tests/resource.rs, crates/ap/tests/api.rs, crates/ap/tests/run.rs and
# crates/ap/tests/measure.rs, ignored by the cargo test above):
# each test binary is built once and run with
# --ignored and the engine of $ont_bin; in CI through sudo (the engine admits only uid 0; a bare `sudo cargo test`
# can lose rustup's toolchain). Each test copies the built ap to a file of mode 0755 of its own temporary
# directory, owned by the user it runs as.
engine_tests=$(cargo test --locked -p ap --test route_engine --test clause --test resource --test api --test run --test measure --no-run --message-format=json \
  | python3 -I -B -c 'import json, sys; print("\n".join(m["executable"] for m in map(json.loads, sys.stdin) if m.get("reason") == "compiler-artifact" and m.get("executable") and m["target"]["name"] in ("route_engine", "clause", "resource", "api", "run", "measure")))')
[ "$(printf '%s\n' "$engine_tests" | grep -c .)" = 6 ] || { echo "engine_tests_missing@check" >&2; exit 1; }
for route_tests in $engine_tests; do
  if [ "${CI:-}" = true ] && [ "$(id -u)" != 0 ]; then
    sudo env "PATH=$PATH" "ONT_BIN=$ont_bin" "CHECK_SKIPS=$CHECK_SKIPS" "$route_tests" --ignored --test-threads=1 --quiet
  else
    ONT_BIN="$ont_bin" "$route_tests" --ignored --test-threads=1 --quiet
  fi
done
# The tests of evals/lesson/replay, of evals/intake/run and of evals/cases build their stores with that engine (which also admits only uid 0).
if [ "${CI:-}" = true ] && [ "$(id -u)" != 0 ]; then
  sudo env "ONT_BIN=$ont_bin" "CHECK_SKIPS=$CHECK_SKIPS" python3 -I -B -m unittest discover -s ci -p 'test_lesson_replay.py'
  sudo env "ONT_BIN=$ont_bin" "CHECK_SKIPS=$CHECK_SKIPS" python3 -I -B -m unittest discover -s ci -p 'test_intake_suite.py'
  sudo env "ONT_BIN=$ont_bin" "CHECK_SKIPS=$CHECK_SKIPS" python3 -I -B -m unittest discover -s ci -p 'test_cases_engine.py'
else
  ONT_BIN="$ont_bin" python3 -I -B -m unittest discover -s ci -p 'test_lesson_replay.py'
  ONT_BIN="$ont_bin" python3 -I -B -m unittest discover -s ci -p 'test_intake_suite.py'
  ONT_BIN="$ont_bin" python3 -I -B -m unittest discover -s ci -p 'test_cases_engine.py'
fi
# The walk of `ap deliver` on the real installer scripts, with the built ap and a scratch store of the same
# engine; it kills real processes under one temporary directory. Skipped, saying so, under CI=true.
bash scripts/test-deliver.sh "$ont_bin" "${CARGO_TARGET_DIR:-$PWD/target}/debug/ap" | grep -v '^walk pass='
# In CI no step has made the host's work directory: the rehearsal and every step after it ran without it.
if [ "${CI:-}" = true ] && { [ -e /home/palantirkc/work ] || [ -L /home/palantirkc/work ]; }; then
  echo "work_directory_exists@check: /home/palantirkc/work was made during the check" >&2
  exit 1
fi
if [ "$mode" = test ]; then say_skips; echo "check: ok (test)"; exit 0; fi
say_skips
echo "check: ok"
