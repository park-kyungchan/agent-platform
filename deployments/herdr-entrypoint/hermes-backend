#!/usr/bin/env bash
set -euo pipefail
hermes_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$hermes_script_dir/hermes-backend.lib.sh"

usage() {
  cat <<'HELP'
Usage: hermes-backend [--profile PROFILE] [--resume SESSION_ID]
       hermes-backend [--profile PROFILE] --native-help
       hermes-backend [--profile PROFILE] --profiles

Open the native Hermes TUI in the existing backend container.
--profile defaults to default and uses native profile resolution.
--resume requires an explicitly selected session; native ownership checks remain active.
Fresh launch requires that profile's native auto-resume setting to resolve false.
SSH authentication uses the caller's native SSH configuration.
HERMES_BACKEND_SSH_TARGET may select the configured alias for the same VPS.
HELP
}

hermes_profile='default'
hermes_profile_seen='no'
hermes_mode='tui'
hermes_resume=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --profile)
      [[ $# -ge 2 && "$hermes_profile_seen" == 'no' ]] || { usage >&2; exit 2; }
      [[ "$2" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]] || { printf '%s\n' 'Invalid native profile name: use 1-64 letters, digits, underscores or hyphens; start with a letter or digit.' >&2; exit 2; }
      hermes_profile="$2"
      hermes_profile_seen='yes'
      shift 2
      ;;
    --resume)
      [[ $# -ge 2 && -z "$hermes_resume" && -n "$2" && "$2" != -* ]] || { usage >&2; exit 2; }
      hermes_resume="$2"
      shift 2
      ;;
    --native-help|--profiles)
      [[ "$hermes_mode" == 'tui' ]] || { usage >&2; exit 2; }
      hermes_mode="$1"
      shift
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
[[ "$hermes_mode" == 'tui' || -z "$hermes_resume" ]] || { usage >&2; exit 2; }
case "$hermes_mode" in
  --native-help) hermes_backend_exec no /opt/hermes/bin/hermes -p "$hermes_profile" --help ;;
  --profiles) hermes_backend_exec no /opt/hermes/bin/hermes -p "$hermes_profile" profile list ;;
esac
hermes_resume_argv=()
if [[ -n "$hermes_resume" ]]; then
  hermes_resume_argv=(--resume "$hermes_resume")
fi

# The verified Docker image contains this bundled artifact. Refuse a missing artifact
# before the native launcher can enter its source-install/build fallback.
hermes_backend_exec yes /usr/bin/bash -c '
  set -euo pipefail
  hermes_selected_profile="$1"
  shift
  if [[ ! -r /opt/hermes/hermes_cli/tui_dist/entry.js ]]; then
    printf "%s\n" "Missing packaged Hermes TUI artifact. Rebuild the owning Hermes image with its native release workflow; no automatic install/build was attempted." >&2
    exit 78
  fi
  if [[ $# -eq 0 ]]; then
    if ! hermes_auto_resume="$(/opt/hermes/bin/hermes -p "$hermes_selected_profile" config get display.tui_auto_resume_recent)"; then
      printf "%s\n" "Could not verify native profile auto-resume preference; TUI was not started." >&2
      exit 78
    fi
    if [[ "$hermes_auto_resume" != false ]]; then
      printf "%s\n" "Native profile auto-resume is not false. Select a session explicitly with --resume; TUI was not started and profile settings were not changed." >&2
      exit 78
    fi
  fi
  exec /opt/hermes/bin/hermes -p "$hermes_selected_profile" --tui "$@"
' hermes-backend "$hermes_profile" "${hermes_resume_argv[@]}"
