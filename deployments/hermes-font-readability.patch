--- a/Dockerfile
+++ b/Dockerfile
@@ -367,6 +367,15 @@
 # The shared assembler binds the prepared environment and frontend products.
 RUN /opt/hermes/.venv/bin/python -m docker.build_agent
 
+# Shipped WOFF2 assets are public and must be readable by the runtime UID.
+# Normalize after assembly, which copies the frontend files with their modes.
+RUN set -eu; \
+    for font_dir in /opt/hermes/hermes_cli/web_dist/fonts /opt/hermes/hermes_cli/web_dist/fonts-terminal; do \
+        if [ -d "$font_dir" ] && [ ! -L "$font_dir" ]; then \
+            find "$font_dir" -maxdepth 1 -type f -name "*.woff2" -exec chmod 0644 {} +; \
+        fi; \
+    done
+
 # Wire the exec shim and install-method stamp.  Files under /opt/hermes are
 # already root-owned (COPY, dep assembly, npm install all run as root) and
 # read-only for the hermes user (go-w from the --chmod above).
