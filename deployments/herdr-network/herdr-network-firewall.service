[Unit]
Description=Owned public VXLAN ingress restriction for srv1873899
Wants=network-online.target
After=network-online.target tailscaled.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/herdr-network-firewall apply
ExecReload=/usr/local/sbin/herdr-network-firewall apply
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
