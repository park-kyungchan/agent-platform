# Included by /etc/gitconfig for the clones ontology-platform and
# agent-vps-operations (main checkout and every linked worktree). No
# push.default here: a branch made by `ap unit run` tracks origin/main, and
# `upstream` would push it to main. Installed as
# /usr/local/lib/agents-git/clones.gitconfig.
[core]
	hooksPath = /usr/local/lib/agents-git/hooks
[agents]
	roster = /root/.local/share/academy-capture-20261113/inputs/students-*.json
