#!/usr/bin/env -S python3 -I -B
"""The routing suite: given an assignment, does a reader that starts at AGENTS.md of the shared instructions find the
context the assignment needs? Several samples per case, scored by facts in the answer; no model judges.

  run answers --root DIR --reader R --out DIR [--cases FILE ...] [--samples N] [--jobs N] [--case ID ...] [--deny GLOB ...]
  run score --out DIR [--cases FILE ...] [--record TASK]
  run bars --score SCORE.json [--reader R]
  run gate --baseline SCORE.json --candidate SCORE.json

Every reader is started through `systemd-run` as a transient service in agents.slice that sees the host read-only
but for /tmp and its own CLI's state, and to which the deny list is inaccessible; there is no other way to start one.
Every refusal is one line {"status":"<code>"} with exit 2. Method and limits: evals/README.md, "The routing suite".
"""
import argparse
import glob
import hashlib
import json
import math
import os
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import threading
import time
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
SELF = os.path.abspath(__file__)
REPO_CASES = os.path.join(HERE, "cases.json")
HOST_DIGESTS = os.path.join(HERE, "host-cases.sha256")
READER_NAMES = ("claude-sonnet", "claude-haiku", "agy-hydrogen")
TIME_BOUND = 600  # seconds per session: the unit's RuntimeMaxSec
GRACE = 30  # seconds past the bound after which this program stops waiting for systemd-run
SLICE = "agents.slice"
KEEP = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LC_ALL", "TMPDIR", "TZ")
# The command lines of the MCP servers registered in the homes of this host's CLIs; a process of a reader's unit whose
# command line holds one of these is an MCP server the run must not start.
MCP_MARKS = ("launcher.mjs", "mcp-server.js", "ont mcp")
ACTIVE = ("active", "activating", "deactivating", "reloading", "refreshing")
ROUTE_MARKS = ("ont fn route", "ap fn route")  # a command that asks the function `route`
BRIEF_MARK = "ap status --brief"  # a command that asks the brief of an intent
CLIENT = "suite"  # the client and the agent of the actions `score --record` applies
PROMPT = ("You are an agent on this host. Your assignment: {situation}\n\n"
          "Ask the functions first: `ont fn route` with `{{\"parameters\":{{\"words\":\"<what you look for>\"}}}}` on "
          "standard input tells you where a fact lives, and `ap status --brief <intent>` tells you the state of an "
          "intent.\n\nBefore you act, find the context you must "
          "load for this assignment. For this test the shared instructions are the directory {root}, laid out as "
          "/root/.agents: start at {root}/AGENTS.md and follow what it routes you to; read nothing under /root/.agents "
          "unless {root} is that directory. For everything else (repositories under /home/palantirkc/platforms/, task "
          "directories under /home/palantirkc/work/, the store) use the host as it is. Never open anything under "
          "/home/palantirkc/work/edu-* or under context/, apps/, modules/ or migration/ of education-platform or academy-platform. Read, "
          "search and run any reading command you need (for this test the host's files are read-only to you): change "
          "nothing, use no web page. Do not do the assignment.\n\n"
          "Answer with the context you would load before acting, as a list: for each item its path (with the "
          "section or lines), and the exact rule, command, path or value from it that your assignment needs, "
          "quoted as it stands there.")
# The deny list: every path that exists when a session starts and matches one of these is inaccessible to it.
# `~` is the caller's home, expanded at the start of each session.
EDU = "/home/palantirkc/platforms/education-platform"
EDU_WT = "/home/palantirkc/work/*/wt/education-platform*"
ACAD = "/home/palantirkc/platforms/academy-platform"
ACAD_WT = "/home/palantirkc/work/*/wt/academy-platform*"
DENY = (["/home/palantirkc/work/edu-*"]
        + ["%s/%s" % (base, d) for base in (EDU, EDU_WT, ACAD, ACAD_WT) for d in ("context", "apps", "modules", "migration")]
        + ["~/.claude*/projects/*edu-*", "~/.claude*/projects/*education-platform*",
           "~/.claude*/projects/*academy-platform*"])


class Refuse(Exception):
    pass


def refuse(code):
    raise Refuse(code)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage")


def start_time(pid):
    """The time a process started, in clock ticks since boot (field 22 of its /proc stat), or None when it is gone."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            return int(f.read().rsplit(")", 1)[1].split()[19])
    except (OSError, IndexError, ValueError):
        return None


# A work directory of a call: `routing-<pid>-<start time>-<random>` in the temporary directory. The pid with its
# start time is the owner's identity: a pid that is reused by another process has another start time.
WORK = re.compile(r"routing-([0-9]+)-([0-9]+)-[a-z0-9_]+")


def work_prefix():
    return "routing-%d-%s-" % (os.getpid(), start_time(os.getpid()))


def sweep_dead_work():
    """Removes the work directories of calls that no longer live: the `routing-*` directories of the form above, owned
    by this user, whose owner (that pid with that start time) is not alive. A directory of a live call, one of another
    form, and anything that is not a directory is left as it is."""
    root = tempfile.gettempdir()
    try:
        names = os.listdir(root)
    except OSError:
        return
    for name in names:
        m = WORK.fullmatch(name)
        if not m or start_time(int(m.group(1))) == int(m.group(2)):
            continue
        path = os.path.join(root, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if os.path.isdir(path) and not os.path.islink(path) and st.st_uid == os.getuid():
            shutil.rmtree(path, ignore_errors=True)


def private_file(path):
    """A file created for writing with mode 0600 (kept at 0600 when it exists): it holds what a reader printed."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "wb")


def sha_file(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def norm(s):
    """Backticks removed, each run of whitespace made one space."""
    return " ".join(s.replace("`", "").split())


def holds(fact, text):
    """A fact holds when every one of its strings is in the (normalised) answer."""
    return all(norm(x) in text for x in fact["fact"])


def passes(case, answer):
    t = norm(answer)
    return all(holds(f, t) for f in case["must"]) and not any(holds(f, t) for f in case["wrong"])


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_atomic(path, text):
    """Written under another name in the same directory and renamed, so a reader never sees half of it."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".part-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


# ---------------------------------------------------------------- cases

def fact_list(v):
    return isinstance(v, list) and all(
        isinstance(f, dict) and isinstance(f.get("fact"), list) and f["fact"]
        and all(isinstance(x, str) and norm(x) for x in f["fact"]) for f in v)


def host_names():
    """Digest to short name, from host-cases.sha256."""
    names = {}
    with open(HOST_DIGESTS, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2:
                names[parts[0]] = parts[1]
    return names


def load_cases(extra):
    """The repository's cases and those of each host file: (id -> case, short name -> SHA-256)."""
    files = [("cases.json", REPO_CASES)]
    known = host_names()
    for path in extra:
        if not os.path.isabs(path) or not os.path.isfile(path):
            refuse("cases_unreadable")
        digest = sha_file(path)
        if digest not in known:
            refuse("cases_digest_unknown")
        files.append((known[digest], path))
    cases, digests = {}, {}
    for name, path in files:
        digests[name] = sha_file(path)
        data = read_json(path)
        if not isinstance(data, list):
            refuse("cases_invalid")
        for c in data:
            if not (isinstance(c, dict) and isinstance(c.get("id"), str) and c["id"] and "/" not in c["id"]
                    and not c["id"].startswith(".") and isinstance(c.get("situation"), str)
                    and fact_list(c.get("must")) and c["must"] and fact_list(c.get("wrong", []))):
                refuse("cases_invalid")
            if c["id"] in cases:
                refuse("case_id_twice")
            cases[c["id"]] = {"id": c["id"], "situation": c["situation"], "must": c["must"],
                              "wrong": c.get("wrong", [])}
    return cases, digests


# ---------------------------------------------------------------- readers

def claude_argv(model):
    # The instructions suite's row with every tool (no --tools) and no prompt (bypassPermissions); no MCP server of
    # the account (--strict-mcp-config), no hook, no auto-memory, no skill.
    def argv(prompt, root, work, sid):
        return ["claude", "--print", "--output-format", "stream-json", "--verbose", "--model", model,
                "--strict-mcp-config", "--permission-mode", "bypassPermissions", "--permission-prompts", "none",
                "--add-dir", root, "--settings", '{"disableAllHooks":true,"autoMemoryEnabled":false}',
                "--disable-slash-commands", "--session-id", sid, prompt]
    return argv


def agy_argv(prompt, root, work, sid):
    # HOME is a new directory without MCP configuration (agy_home); every action allowed.
    allow = ["read_file(%s)" % root] + ["command(%s)" % c for c in ("rg", "grep", "cat", "sed", "head", "tail", "ls", "find", "wc")]
    return ["agy", "--print", prompt, "--output-format", "stream-json", "--model", "gemini-4-hydrogen-low",
            "--add-dir", root, "--settings", json.dumps({"permissions": {"allow": allow}}),
            "--dangerously-skip-permissions"]


def agy_home(home):
    """A home for one agy run: links to the login token and the instruction pointers, no MCP, hook or skill file."""
    real = os.path.expanduser("~")
    os.makedirs(home + "/.gemini/antigravity-cli")
    os.symlink(real + "/.gemini/antigravity-cli/antigravity-oauth-token", home + "/.gemini/antigravity-cli/antigravity-oauth-token")
    for name in ("AGENTS.md", "GEMINI.md"):
        os.symlink("/root/.agents/AGENTS.md", home + "/.gemini/" + name)


def claude_state():
    d = os.environ.get("CLAUDE_CONFIG_DIR")
    return [os.path.abspath(d)] if d else [os.path.expanduser("~/.claude"), os.path.expanduser("~/.claude.json")]


def agy_state():
    return [os.path.expanduser("~/.gemini/antigravity-cli")]


# One row per reader: the CLI, its command line, its environment beyond KEEP, the state it writes.
READERS = {
    "claude-sonnet": {"cli": "claude", "argv": claude_argv("sonnet"), "env": ("CLAUDE_CONFIG_DIR",), "state": claude_state},
    "claude-haiku": {"cli": "claude", "argv": claude_argv("haiku"), "env": ("CLAUDE_CONFIG_DIR",), "state": claude_state},
    "agy-hydrogen": {"cli": "agy", "argv": agy_argv, "env": (), "home": agy_home, "state": agy_state},
}


def events(stream):
    for line in stream.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict):
            yield e


def answer_of(reader, stream):
    """The final answer from the saved stream of events, or None."""
    text = None
    for e in events(stream):
        if reader.startswith("claude") and e.get("type") == "result" and isinstance(e.get("result"), str):
            text = e["result"]
        elif reader == "agy-hydrogen" and e.get("event") == "result" and isinstance((e.get("result") or {}).get("response"), str):
            text = e["result"]["response"]
    return text


def num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def usage_of(reader, stream):
    """(input tokens, cached included; output tokens; the CLI's own session id) from the saved stream."""
    tin = tout = sid = None
    for e in events(stream):
        if reader.startswith("claude") and e.get("type") == "result":
            u = e.get("usage") if isinstance(e.get("usage"), dict) else {}
            tin = sum(num(u.get(k)) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            tout = num(u.get("output_tokens"))
        elif reader == "agy-hydrogen":
            if sid is None and isinstance(e.get("session_id"), str) and e["session_id"]:
                sid = e["session_id"]
            if e.get("event") == "result":
                r = e.get("result") if isinstance(e.get("result"), dict) else {}
                u = r.get("usage") if isinstance(r.get("usage"), dict) else {}
                tin = num(u.get("input_tokens")) + num(u.get("cache_read_tokens"))
                tout = num(u.get("output_tokens"))
    return tin, tout, sid


def utc(t):
    """A time in seconds since the epoch as UTC text to the second."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def strings(v):
    """Every string of a JSON value."""
    if isinstance(v, str):
        yield v
    elif isinstance(v, dict):
        for x in v.values():
            yield from strings(x)
    elif isinstance(v, list):
        for x in v:
            yield from strings(x)


def fn_calls_of(reader, stream):
    """{"route","brief"} for a Claude reader: its `tool_use` blocks, each counted once by its id, whose input holds
    `ont fn route` or `ap fn route` (route) or `ap status --brief` (brief). None for the other readers."""
    if not reader.startswith("claude"):
        return None
    seen, route, brief = set(), 0, 0
    for e in events(stream):
        message = e.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        for b in content if isinstance(content, list) else []:
            if not (isinstance(b, dict) and b.get("type") == "tool_use" and isinstance(b.get("id"), str)) \
                    or b["id"] in seen:
                continue
            seen.add(b["id"])
            text = list(strings(b.get("input")))
            route += any(m in t for m in ROUTE_MARKS for t in text)
            brief += any(BRIEF_MARK in t for t in text)
    return {"route": route, "brief": brief}


def usd_of(reader, stream):
    """The `total_cost_usd` of the last `result` event of a Claude reader's stream (the CLI's own figure), else None."""
    usd = None
    for e in events(stream):
        if reader.startswith("claude") and e.get("type") == "result":
            v = e.get("total_cost_usd")
            usd = v if isinstance(v, (int, float)) and not isinstance(v, bool) else None
    return usd


# ---------------------------------------------------------------- the unit

def unit_of(base):
    """The unit of one sample: named by the SHA-256 of the absolute path of the sample."""
    return "routing-%s" % hashlib.sha256(os.path.abspath(base).encode()).hexdigest()[:16]


def quoted(path):
    """One path as a word of a unit property list (systemd unquotes it)."""
    if any(c in path for c in " \t\"'\\"):
        return '"%s"' % path.replace("\\", "\\\\").replace('"', '\\"')
    return path


def deny_paths(extra):
    """Every existing path that matches the deny list or a --deny glob, computed now."""
    found = set()
    for pattern in list(DENY) + list(extra):
        for p in glob.glob(os.path.expanduser(pattern), include_hidden=True):
            if "\n" not in p:
                found.add(os.path.abspath(p))
    return sorted(found)


def unit_argv(tool, unit, description, work, writable, deny, env):
    argv = [tool, "--wait", "--pipe", "--quiet", "--collect", "--unit=" + unit, "--slice=" + SLICE,
            "--description=" + description, "--expand-environment=no", "--working-directory=" + work,
            "-p", "ProtectSystem=strict", "-p", "ProtectHome=read-only", "-p", "RuntimeMaxSec=%d" % TIME_BOUND]
    for w in writable:
        argv += ["-p", "ReadWritePaths=" + quoted("-" + w)]
    for d in deny:
        argv += ["-p", "InaccessiblePaths=" + quoted("-" + d)]
    return argv + ["--setenv=%s=%s" % (k, v) for k, v in sorted(env.items())]


def started_argv(mark, argv):
    """The command of the unit: leave the mark that the unit started, then become the CLI."""
    return ["/bin/sh", "-c", 'printf started > "$0" && exec "$@"', mark] + argv


class Sandbox:
    def __init__(self, reader, deny_extra):
        self.run = shutil.which("systemd-run")
        self.ctl = shutil.which("systemctl")
        if not self.run or not self.ctl:
            refuse("sandbox_unavailable")
        self.reader = reader
        self.deny_extra = deny_extra
        self.writable = ["/tmp"] + READERS[reader]["state"]()

    def active(self, units):
        """The units of the list that are active now."""
        found = []
        for i in range(0, len(units), 50):
            part = [u + ".service" for u in units[i:i + 50]]
            r = subprocess.run([self.ctl, "is-active", "--"] + part, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True)
            lines = r.stdout.split()
            if len(lines) != len(part):
                refuse("sandbox_unavailable")
            found += [u for u, s in zip(units[i:i + 50], lines) if s in ACTIVE]
        return found

    def control_group(self, unit):
        r = subprocess.run([self.ctl, "show", "-p", "ControlGroup", "--value", "--", unit + ".service"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        cg = r.stdout.strip()
        return cg if r.returncode == 0 and cg.startswith("/") else None

    def probe(self, out):
        """A unit of the same properties whose command only leaves the mark: no reader starts unless it does."""
        tmp = tempfile.mkdtemp(prefix=work_prefix())
        try:
            mark = os.path.join(tmp, "started")
            unit = unit_of(os.path.join(out, ".probe-" + uuid.uuid4().hex))
            argv = unit_argv(self.run, unit, "routing-%s-probe" % self.reader, tmp, self.writable,
                             deny_paths(self.deny_extra), {"PATH": "/usr/bin:/bin"})
            try:
                subprocess.run(argv + ["--", "/bin/sh", "-c", 'printf started > "$0"', mark], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
            except (OSError, subprocess.TimeoutExpired):
                pass
            if not os.path.isfile(mark):
                refuse("sandbox_unavailable")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)


def pids_below(root_pid):
    parent = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                with open("/proc/%s/stat" % d) as f:
                    parent[int(d)] = int(f.read().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
    found = []
    for pid in parent:
        p, seen = pid, set()
        while p in parent and p not in seen and p > 1:
            seen.add(p)
            p = parent[p]
            if p == root_pid:
                found.append(pid)
                break
    return found


def pids_of_group(cg):
    found = []
    for d, _, files in os.walk("/sys/fs/cgroup" + cg):
        if "cgroup.procs" in files:
            try:
                with open(os.path.join(d, "cgroup.procs")) as f:
                    found += [int(x) for x in f.read().split()]
            except (OSError, ValueError):
                continue
    return found


def with_marks(pids):
    found = []
    for pid in pids:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                line = f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if any(m in line for m in MCP_MARKS):
            found.append(pid)
    return found


# ---------------------------------------------------------------- answers

def done(base):
    """A sample is done when its usage file says answered and its answer is not empty."""
    meta = read_json(base + ".json")
    if not (isinstance(meta, dict) and meta.get("answered") is True):
        return False
    try:
        return os.path.getsize(base + ".md") > 0
    except OSError:
        return False


def run_sample(a, sandbox, case, n, base):
    """One session in its own unit; its files are <base>.md, .json, .jsonl, .err. Returns the usage record."""
    row = READERS[a.reader]
    for suffix in (".json", ".md"):
        try:
            os.unlink(base + suffix)
        except FileNotFoundError:
            pass
    sweep_dead_work()
    tmp = tempfile.mkdtemp(prefix=work_prefix())
    work, mark = os.path.join(tmp, "work"), os.path.join(tmp, "started")
    os.mkdir(work)
    sid = str(uuid.uuid4())
    unit = unit_of(base)
    meta = {"reader": a.reader, "case": case["id"], "sample": n, "unit": unit, "session": sid, "state": None,
            "exit": None, "seconds": None, "input_tokens": None, "output_tokens": None, "answered": False,
            "mcp_processes": [], "started_at": None, "ended_at": None, "fn_calls": None, "usd": None}
    try:
        env = {k: os.environ[k] for k in KEEP + row["env"] if k in os.environ}
        env["TERM"] = "dumb"
        if row.get("home"):
            home = os.path.join(tmp, "home")
            row["home"](home)
            env["HOME"] = home
        prompt = PROMPT.format(situation=case["situation"], root=a.root)
        cli = row["argv"](prompt, a.root, work, sid)
        cli[0] = shutil.which(cli[0]) or cli[0]
        argv = unit_argv(sandbox.run, unit, "routing-%s-%s-s%d" % (a.reader, case["id"], n), work,
                         sandbox.writable, deny_paths(a.deny), env)
        argv += ["--"] + started_argv(mark, cli)
        start = time.time()
        with private_file(base + ".jsonl") as so, private_file(base + ".err") as se:
            try:
                p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=so, stderr=se, start_new_session=True)
            except OSError:
                meta["state"] = "sandbox_unavailable"
                return meta
            seen, stop = set(), threading.Event()

            def watch():
                cg, asked = None, 0.0
                while not stop.is_set():
                    if cg is None and time.time() - asked >= 1.0:
                        asked = time.time()
                        cg = sandbox.control_group(unit)
                    seen.update(with_marks(pids_of_group(cg) if cg else pids_below(p.pid)))
                    stop.wait(0.2)
            t = threading.Thread(target=watch, daemon=True)
            t.start()
            try:
                meta["exit"] = p.wait(timeout=TIME_BOUND + GRACE)
            except subprocess.TimeoutExpired:
                os.killpg(p.pid, signal.SIGKILL)
                p.wait()
                meta["state"] = "timeout"
            stop.set()
            t.join()
        ended = time.time()
        meta["seconds"] = round(ended - start, 1)
        meta["mcp_processes"] = sorted(seen)
        if not os.path.isfile(mark):
            meta["state"] = "sandbox_unavailable"
            return meta
        meta["started_at"], meta["ended_at"] = utc(os.path.getmtime(mark)), utc(ended)
        with open(base + ".jsonl", encoding="utf-8", errors="replace") as f:
            stream = f.read()
        answer = answer_of(a.reader, stream)
        meta["input_tokens"], meta["output_tokens"], own = usage_of(a.reader, stream)
        meta["fn_calls"], meta["usd"] = fn_calls_of(a.reader, stream), usd_of(a.reader, stream)
        if own:
            meta["session"] = own
        if answer:
            write_atomic(base + ".md", answer)
        if meta["state"] is None and meta["seconds"] >= TIME_BOUND:
            meta["state"] = "timeout"
        if meta["state"] is None:
            meta["state"] = "ok" if meta["exit"] == 0 and answer else "failed"
        meta["answered"] = meta["state"] == "ok"
        return meta
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        if meta["state"] is not None:
            write_atomic(base + ".json", json.dumps(meta, indent=1) + "\n")


def cmd_answers(a):
    if a.reader not in READERS:
        refuse("usage")
    if not 1 <= a.samples <= 9 or not 1 <= a.jobs <= 4:
        refuse("usage")
    a.root = os.path.abspath(a.root)
    if not os.path.isfile(os.path.join(a.root, "AGENTS.md")):
        refuse("root_invalid")
    cases, digests = load_cases(a.cases)
    if [c for c in a.case if c not in cases]:
        refuse("case_unknown")
    ids = sorted(set(a.case) if a.case else cases)
    sandbox = Sandbox(a.reader, a.deny)
    if not shutil.which(READERS[a.reader]["cli"]):
        refuse("cli_missing")
    out = os.path.join(os.path.abspath(a.out), a.reader)
    record = {"samples": a.samples, "cases": ids, "case_files": digests, "suite": sha_file(SELF)}
    old = read_json(os.path.join(out, "run.json")) if os.path.exists(os.path.join(out, "run.json")) else None
    if os.path.exists(os.path.join(out, "run.json")):
        if not isinstance(old, dict) or any(old.get(k) != record[k] for k in ("cases", "case_files", "suite")) \
                or not isinstance(old.get("samples"), int) or old["samples"] > a.samples:
            refuse("run_differs")
    todo = [(cases[cid], n) for n in range(1, a.samples + 1) for cid in ids]
    states = {}
    for c, n in todo:
        if done(os.path.join(out, "%s__s%d" % (c["id"], n))):
            states["%s__s%d" % (c["id"], n)] = "done"
    todo = [(c, n) for c, n in todo if "%s__s%d" % (c["id"], n) not in states]
    if sandbox.active([unit_of(os.path.join(out, "%s__s%d" % (c["id"], n))) for c, n in todo]):
        refuse("run_still_active")
    sweep_dead_work()  # after the last refusal: the work directories of killed calls
    os.makedirs(out, exist_ok=True)
    if todo:
        sandbox.probe(out)
    if old is None or old.get("samples") != a.samples:
        write_atomic(os.path.join(out, "run.json"), json.dumps(record, indent=1) + "\n")
    broke, lost, lock = [], [], threading.Lock()

    def worker():
        while True:
            with lock:
                if not todo or broke or lost:
                    return
                c, n = todo.pop(0)
            key = "%s__s%d" % (c["id"], n)
            try:
                m = run_sample(a, sandbox, c, n, os.path.join(out, key))
            except Exception:  # an error of this program for one sample: the sample stays unanswered
                m = {"state": "failed", "mcp_processes": []}
            with lock:
                states[key] = m["state"]
                if m["state"] == "sandbox_unavailable":
                    lost.append(key)
                if m["mcp_processes"]:
                    broke.append(key)  # the MCP rule did not hold: start no further session
    # Daemon threads: a stopped call ends at once; a unit it started runs on, and no answer of it is written.
    threads = [threading.Thread(target=worker, daemon=True) for _ in range(a.jobs)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if lost:
        refuse("sandbox_unavailable")
    for c, n in todo:
        states["%s__s%d" % (c["id"], n)] = "not_run"
    print(json.dumps({"reader": a.reader, "samples": dict(sorted(states.items())), "mcp_rule_broken": sorted(broke)},
                     indent=1))
    return 2 if broke else 0


# ---------------------------------------------------------------- score

def cost_members(metas):
    """`fn_samples` and `usd` of a reader from the usage records of its scored samples: the share of those that carry
    a count and called a function at least once (four places), and the sum of their `usd` (two places); each None
    when no sample has the figure."""
    counts = [m["fn_calls"] for m in metas if isinstance(m.get("fn_calls"), dict)]
    called = sum(1 for c in counts if num(c.get("route")) + num(c.get("brief")) > 0)
    spent = [m["usd"] for m in metas if isinstance(m.get("usd"), (int, float)) and not isinstance(m["usd"], bool)]
    return {"fn_samples": round(called / len(counts), 4) if counts else None,
            "usd": round(sum(spent), 2) if spent else None}


def latest_end(d, record):
    """The latest `ended_at` of a reader's scored samples, or None."""
    ends = []
    for cid in record["cases"]:
        for s in range(1, record["samples"] + 1):
            base = os.path.join(d, "%s__s%d" % (cid, s))
            if done(base):
                meta = read_json(base + ".json")
                if isinstance(meta.get("ended_at"), str) and meta["ended_at"]:
                    ends.append(meta["ended_at"])
    return max(ends) if ends else None


def score_reader(d, record, cases):
    n, ids = record["samples"], record["cases"]
    passed = {cid: 0 for cid in ids}
    per_sample = [0] * n
    unanswered, tokens, metas = 0, [], []
    for cid in ids:
        for s in range(1, n + 1):
            base = os.path.join(d, "%s__s%d" % (cid, s))
            if not done(base):
                unanswered += 1
                continue
            meta = read_json(base + ".json")
            metas.append(meta)
            with open(base + ".md", encoding="utf-8", errors="replace") as f:
                text = f.read()
            if isinstance(meta.get("input_tokens"), int):
                tokens.append(meta["input_tokens"])
            if passes(cases[cid], text):
                passed[cid] += 1
                per_sample[s - 1] += 1
    return {"n": n, "passes": passed, "samples": per_sample, "mean": round(sum(per_sample) / n, 4),
            "majority": sorted(cid for cid in ids if passed[cid] > n / 2), "unanswered": unanswered,
            "tokens_median": statistics.median(tokens) if tokens else None, **cost_members(metas)}


def sheet(result):
    lines = ["# Routing suite: score", "", "Suite (SHA-256 of `run`): `%s`" % result["suite"], "", "Case files:", ""]
    lines += ["- `%s`: `%s`" % (k, v) for k, v in sorted(result["case_files"].items())]
    readers = list(result["readers"])
    lines += ["", "| Reader | n | mean | passed cases per sample | majority | unanswered | input tokens (median) | parity |",
              "| --- | --- | --- | --- | --- | --- | --- | --- |"]
    for r in readers:
        x = result["readers"][r]
        par = result["parity"].get(r)
        lines.append("| %s | %d | %s | %s | %d of %d | %d | %s | %s |" % (
            r, x["n"], x["mean"], " ".join(str(v) for v in x["samples"]), len(x["majority"]), len(x["passes"]),
            x["unanswered"], "-" if x["tokens_median"] is None else x["tokens_median"],
            "-" if par is None else par))
    ids = sorted({cid for r in readers for cid in result["readers"][r]["passes"]})
    lines += ["", "Passed samples per case:", "", "| Case | " + " | ".join(readers) + " |",
              "| --- |" + " --- |" * len(readers)]
    for cid in ids:
        cells = []
        for r in readers:
            x = result["readers"][r]
            cells.append("%d/%d" % (x["passes"][cid], x["n"]) if cid in x["passes"] else "-")
        lines.append("| %s | %s |" % (cid, " | ".join(cells)))
    return "\n".join(lines) + "\n"


def parity_of(sonnet, majority):
    """The share of Sonnet's majority that is in the reader's majority (None without Sonnet or with an empty one)."""
    return len(set(sonnet) & set(majority)) / len(sonnet) if sonnet else None


# ---------------------------------------------------------------- the record of a score

def ont_call(args, body):
    """The answer object of one `ont` call on the host's store (the `ont` of PATH, no `--store`), or None."""
    cmd = [shutil.which("ont") or "ont"] + args
    env = {k: v for k, v in os.environ.items() if k not in ("ONT_AGENT", "ONT_ROLE")}  # the request id is the caller's
    if args[:2] == ["action", "apply"] and isinstance(body, dict) and "role" not in body:
        body = {**body, "role": "lead"}  # the score's record is the Lead's (specs/ap/roles.md R3)
    for attempt in range(4):
        try:
            p = subprocess.run(cmd, input=json.dumps(body), capture_output=True, text=True, timeout=120, env=env)
            v = json.loads(p.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return None
        if isinstance(v, dict) and v.get("code") == "store_busy" and attempt < 3:
            time.sleep(0.2)
            continue
        return v if isinstance(v, dict) else None


def ont_search(object_type, where=None):
    """[(id, fields)] of every page of a search, each field its value or None; None when an answer is unreadable."""
    body = {"object_type": object_type, "limit": 200}
    if where is not None:
        body["where"] = where
    found = []
    while True:
        v = ont_call(["search"], body)
        r = v.get("result") if isinstance(v, dict) and v.get("status") == "ok" else None
        if not isinstance(r, dict) or not isinstance(r.get("objects"), list):
            return None
        for o in r["objects"]:
            ident = o.get("id") if isinstance(o, dict) else None
            fields = (o.get("head") or {}).get("fields") if isinstance(o, dict) else None
            if not isinstance(ident, dict) or not isinstance(fields, dict):
                return None
            found.append((ident, {k: (f.get("value") if isinstance(f, dict) and f.get("kind") == "value" else None)
                                  for k, f in fields.items()}))
        c = r.get("continuation")
        if c is None:
            return found
        if c == body.get("continuation"):
            return None
        body["continuation"] = c


def ont_apply(kind, rid, params):
    """(outcome, codes, the kpi id the action made): the outcome is None when the store refused or failed."""
    v = ont_call(["action", "apply", "--client", CLIENT],
                 {"action_type": kind, "agent": CLIENT, "request_id": rid, "parameters": params})
    if not isinstance(v, dict):
        return None, [], None
    if v.get("status") == "refused":
        failed = v.get("failed") if isinstance(v.get("failed"), list) else []
        return None, [x for x in [v.get("code")] + failed if isinstance(x, str)], None
    result = v.get("result") if isinstance(v.get("result"), dict) else {}
    if v.get("status") == "ok" and result.get("outcome") in ("applied", "already_applied"):
        made = next((e["id"] for e in result.get("edits") or [] if isinstance(e, dict) and isinstance(e.get("id"), dict)
                     and e["id"].get("object_type") == "kpi"), None)
        return result["outcome"], [], made
    return None, [], None


def is_task(ident, key, kind="task"):
    return isinstance(ident, dict) and ident.get("object_type") == kind and ident.get("native_key") == key


def kpi_of(task, key, name):
    """The full id of the KPI `name` of the task, defined when there is none; None when the store does not answer."""
    found = ont_search("kpi", {"eq": ["name", name]})
    if found is None:
        return None
    mine = [i for i, f in found if is_task(f.get("task"), key)]
    if mine:
        return mine[0]
    definition = ("Score of the %s suite for the reader %s in one scored run: mean share of passed cases, majority over "
                  "all cases, samples per case, unanswered samples, share of answered samples that called a function, "
                  "and the readers' own cost in USD; recorded by evals/%s/run score --record. No case text.")
    suite, reader = name.split()[1:3]
    _, _, made = ont_apply("define_kpi", "suite-kpi-" + hashlib.sha256(("%s:%s" % (key, name)).encode()).hexdigest()[:32],
                           {"task": task, "name": name, "definition": definition % (suite, reader, suite)})
    if made is not None:
        return made
    again = ont_search("kpi", {"eq": ["name", name]})
    return next((i for i, f in again or [] if is_task(f.get("task"), key)), None)


def measured(x):
    """The value text of one reader's measurement (None written n/a)."""
    cell = lambda v, places: "n/a" if v is None else "%.*f" % (places, v)
    return "mean %s majority %d/%d n %d unanswered %d fn %s usd %s" % (
        cell(x["mean"], 4), len(x["majority"]), len(x["passes"]), x["n"], x["unanswered"], cell(x.get("fn_samples"), 4),
        cell(x.get("usd"), 2))


def record_scores(suite, out, key, records, result, digest):
    """One measurement of the KPI `suite <suite> <reader>` of the task `key` per reader of a score; the counts."""
    done_ = {"measurements": 0, "already": 0, "older": 0, "skipped": 0, "failed": 0}
    ends = {r: latest_end(os.path.join(out, r), records[r]) for r in result["readers"]}
    found = ont_search("task")
    task = next((i for i, _ in found or [] if is_task(i, key)), None)
    if task is None:
        done_["failed"] = len(ends)
        return done_
    for reader, end in ends.items():
        if end is None:
            done_["skipped"] += 1
            continue
        kpi = kpi_of(task, key, "suite %s %s" % (suite, reader))
        if kpi is None:
            done_["failed"] += 1
            continue
        rid = "suite-" + hashlib.sha256(("%s:%s" % (reader, digest)).encode()).hexdigest()[:32]
        outcome, codes, _ = ont_apply("record_measurement", rid, {
            "kpi": kpi, "value": measured(result["readers"][reader]), "observed_at": end,
            "evidence": "evals/%s/run score sha256:%s" % (suite, digest)})
        if outcome == "applied":
            done_["measurements"] += 1
        elif outcome == "already_applied":
            done_["already"] += 1
        elif "older_measurement" in codes:
            done_["older"] += 1
        else:
            done_["failed"] += 1
    return done_


def report(a, suite, out, records, result, text):
    """Prints the score, and with `--record` also the counts of the measurements; exit 3 when one failed."""
    if a.record is None:
        print(text)
        return 0
    counts = record_scores(suite, out, a.record, records, result, hashlib.sha256((text + "\n").encode()).hexdigest())
    print(json.dumps(dict(result, recorded=counts), indent=1))
    return 3 if counts["failed"] else 0


def cmd_score(a):
    if a.record == "":
        refuse("usage")
    out = os.path.abspath(a.out)
    readers = [r for r in READER_NAMES if os.path.isdir(os.path.join(out, r))]
    if not readers:
        refuse("no_reader")
    records = {}
    for r in readers:
        rec = read_json(os.path.join(out, r, "run.json"))
        if not (isinstance(rec, dict) and isinstance(rec.get("samples"), int) and rec["samples"] >= 1
                and isinstance(rec.get("cases"), list) and isinstance(rec.get("case_files"), dict)):
            refuse("run_record_missing")
        records[r] = rec
    first = records[readers[0]]
    if any(rec.get("suite") != first.get("suite") or rec["case_files"] != first["case_files"] for rec in records.values()):
        refuse("run_differs")
    cases, digests = load_cases(a.cases)
    if digests != first["case_files"] or any(cid not in cases for rec in records.values() for cid in rec["cases"]):
        refuse("case_sets_differ")
    result = {"suite": first.get("suite"), "case_files": digests,
              "readers": {r: score_reader(os.path.join(out, r), records[r], cases) for r in readers}}
    sonnet = result["readers"].get("claude-sonnet", {}).get("majority")
    result["parity"] = {r: (None if parity_of(sonnet, x["majority"]) is None else round(parity_of(sonnet, x["majority"]), 4))
                        for r, x in result["readers"].items() if r != "claude-sonnet"}
    text = json.dumps(result, indent=1)
    write_atomic(os.path.join(out, "score.json"), text + "\n")
    write_atomic(os.path.join(out, "sheet.md"), sheet(result))
    return report(a, "routing", out, records, result, text)


# ---------------------------------------------------------------- bars

# The bars of a reader against Sonnet, from a score file. G4 and G5 are not measured here.
BARS_N = 3  # the fewest samples a bar is read at


def measure(x, sonnet):
    """(parity, share of unanswered samples as (unanswered, samples), ratio of the input-token medians) of a judged
    reader against Sonnet's; a member that cannot be had is None."""
    cells = x["n"] * len(x["passes"])
    t, base = x.get("tokens_median"), sonnet.get("tokens_median")
    number = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    ratio = (t / base) if number(t) and number(base) and base > 0 else None
    return (parity_of(sonnet["majority"], x["majority"]), (x["unanswered"], cells) if cells else None, ratio)


def cmd_bars(a):
    reader = a.reader
    if reader not in READER_NAMES or reader == "claude-sonnet":
        refuse("usage")
    score = read_json(a.score)
    readers = score.get("readers") if isinstance(score, dict) else None
    if not (isinstance(readers, dict) and judged(readers.get("claude-sonnet"))):
        refuse("score_unreadable")
    sonnet, x = readers["claude-sonnet"], readers.get(reader)
    if x is not None and not judged(x):
        refuse("score_unreadable")
    if x is not None and set(x["passes"]) != set(sonnet["passes"]):
        refuse("case_sets_differ")  # the bars compare the same cases; a subset is judged against the same subset
    if x is None or x["n"] < BARS_N:
        values = (None, None, None)  # a reader that is absent, or read at fewer samples, misses every bar
    else:
        values = measure(x, sonnet)
    parity, share, ratio = values
    if sonnet["n"] < BARS_N:
        parity = ratio = None
    held = {"G1": parity is not None and parity >= 0.90,
            "G2": share is not None and share[0] * 24 <= 2 * share[1],
            "G3": ratio is not None and ratio <= 1.2}
    bars = {"G1": {"bar": "parity >= 0.90", "value": None if parity is None else round(parity, 4)},
            "G2": {"bar": "unanswered rate <= 2/24", "value": None if share is None else round(share[0] / share[1], 4)},
            "G3": {"bar": "tokens_median ratio <= 1.2", "value": None if ratio is None else round(ratio, 4)}}
    for k in bars:
        bars[k]["ok"] = held[k]
    information = {}
    for r, y in sorted(readers.items()):
        if r not in ("claude-sonnet", reader) and judged(y) and y["n"] >= 1:
            p, s, t = measure(y, sonnet)
            information[r] = {"parity": None if p is None else round(p, 4),
                              "unanswered_rate": None if s is None else round(s[0] / s[1], 4),
                              "tokens_ratio": None if t is None else round(t, 4)}
    missed = [k for k in bars if not held[k]]
    print(json.dumps({"status": "fail" if missed else "pass", "reader": reader, "bars": bars, "missed": missed,
                      "information": information}, indent=1))
    return 1 if missed else 0


# ---------------------------------------------------------------- gate

def judged(x):
    return (isinstance(x, dict) and isinstance(x.get("n"), int) and isinstance(x.get("passes"), dict)
            and isinstance(x.get("unanswered"), int) and isinstance(x.get("majority"), list)
            and all(isinstance(v, int) for v in x["passes"].values()))


def cmd_gate(a):
    base, cand = read_json(a.baseline), read_json(a.candidate)
    if not (isinstance(base, dict) and isinstance(cand, dict) and isinstance(base.get("readers"), dict)
            and isinstance(cand.get("readers"), dict)
            and all(judged(x) for s in (base, cand) for x in s["readers"].values())):
        refuse("score_unreadable")
    B, C = base["readers"], cand["readers"]
    every = list(B.values()) + list(C.values())
    if any(x["n"] < 3 for x in every):
        refuse("samples_too_few")
    if any(x["unanswered"] * 20 > len(x["passes"]) * x["n"] for x in every):
        refuse("run_incomplete")
    if base.get("case_files") != cand.get("case_files") or any(set(B[r]["passes"]) != set(C[r]["passes"]) for r in B if r in C):
        refuse("case_sets_differ")
    readers, ok = {}, True
    for r, b in B.items():
        bm = sum(b["passes"].values()) / b["n"]
        if r not in C:
            readers[r] = {"baseline_mean": round(bm, 3), "candidate_mean": None, "drop": None, "noise": None,
                          "ok": False, "lost": sorted(b["majority"])}
            ok = False
            continue
        c = C[r]
        nb, nc = b["n"], c["n"]
        cm = sum(c["passes"].values()) / nc
        drop = bm - cm
        var = 0.0
        for cid, bi in b["passes"].items():
            p = (bi + c["passes"][cid]) / (nb + nc)
            var += p * (1 - p)
        noise = math.sqrt(var * (1 / nb + 1 / nc))
        good = drop <= 2 * noise
        ok = ok and good
        readers[r] = {"baseline_mean": round(bm, 3), "candidate_mean": round(cm, 3), "drop": round(drop, 3),
                      "noise": round(noise, 3), "ok": good,
                      "lost": sorted(set(b["majority"]) - set(c["majority"]))}
    print(json.dumps({"status": "pass" if ok else "fail", "readers": readers}, indent=1))
    return 0 if ok else 1


def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    p = Parser(prog="run", allow_abbrev=False)
    sub = p.add_subparsers(dest="verb", required=True, parser_class=Parser)
    an = sub.add_parser("answers", allow_abbrev=False)
    an.add_argument("--root", required=True)
    an.add_argument("--reader", required=True)
    an.add_argument("--out", required=True)
    an.add_argument("--cases", action="append", default=[])
    an.add_argument("--samples", type=int, default=3)
    an.add_argument("--jobs", type=int, default=2)
    an.add_argument("--case", action="append", default=[])
    an.add_argument("--deny", action="append", default=[])
    sc = sub.add_parser("score", allow_abbrev=False)
    sc.add_argument("--out", required=True)
    sc.add_argument("--cases", action="append", default=[])
    sc.add_argument("--record", default=None)
    ba = sub.add_parser("bars", allow_abbrev=False)
    ba.add_argument("--score", required=True)
    ba.add_argument("--reader", default="agy-hydrogen")
    ga = sub.add_parser("gate", allow_abbrev=False)
    ga.add_argument("--baseline", required=True)
    ga.add_argument("--candidate", required=True)
    try:
        a = p.parse_args()
        return {"answers": cmd_answers, "score": cmd_score, "bars": cmd_bars, "gate": cmd_gate}[a.verb](a)
    except Refuse as e:
        print(json.dumps({"status": e.args[0]}, separators=(",", ":")))
        return 2


if __name__ == "__main__":
    sys.exit(main())
