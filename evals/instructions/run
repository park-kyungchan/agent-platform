#!/usr/bin/env -S python3 -I -B
"""The instructions suite: does a reader find, from AGENTS.md section 3, how a CLI is run and configured without a
terminal UI? For each case of cases.json it starts ONE headless session of the reader in a new empty directory with
the fixed prompt, saves the answer, and scores it by two literal rules (no model judges): `routed` (the last line
that begins `File:` names one of the case's files) and `answered` (every token is in the answer). `--score <dir>`
starts no session and scores the answers saved there. It prints ONE JSON object. Exit 0 when every session ran or the
reader may not be run; 2 when a start failed or a usage error (the object, or one JSON line, says which).
Method and limits: evals/README.md, section "The instructions suite".
"""
import argparse
import glob
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
TIME_BOUND = 600  # seconds per session; a session past it is ended by its process group and counts as not run
KEEP = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LC_ALL", "TMPDIR", "TZ")
# The command lines of the MCP servers registered in the homes of this host's CLIs; a process of a reader whose
# command line holds one of these is an MCP server the run must not start.
MCP_MARKS = ("launcher.mjs", "mcp-server.js", "ont mcp")
WITHHELD = "MCP startup withheld"
PROMPT = ("You are an agent on this host. Situation: {situation} Find the answer in the shared instructions. For this "
          "test they are the directory {root}, laid out as /root/.agents: start at {root}/AGENTS.md, section 3, and "
          "read only what it routes you to under {root}. Read no help text and no web page, read nothing under "
          "/root/.agents unless {root} is that directory, and run no command of the CLI the situation is about. "
          "Answer with the exact command line or setting, complete enough to be run as it stands. End with one line: "
          "File: <the name of the file in which you found it>")


def claude_argv(prompt, root, work, sid):
    # No MCP server of the account (--strict-mcp-config), no hook, no auto-memory, no skill; read-only tools that
    # may read the copy of the instructions (--add-dir) and nothing that would prompt (dontAsk, prompts none).
    return ["claude", "--print", "--output-format", "stream-json", "--verbose", "--model", "haiku",
            "--strict-mcp-config", "--permission-mode", "dontAsk", "--permission-prompts", "none",
            "--tools", "Read,Grep,Glob", "--add-dir", root,
            "--settings", '{"disableAllHooks":true,"autoMemoryEnabled":false}', "--disable-slash-commands",
            "--session-id", sid, prompt]


def muse_argv(prompt, root, work, sid):
    # A new workspace Muse Code does not trust: no --yolo, no --trust-workspace, so MCP startup is withheld; no shell,
    # no web. File reads pass in every approval mode. (--disable-write is left out: with it the CLI refused the model,
    # "does not exist or you lack access", on this host.)
    return ["muse", "exec", "--json", "--model", "muse-ember-1.0", "--disable-reminders", "--disable-shell",
            "--disable-web-tools", "--disable-request-user-input", "--session-id", sid,
            "--workspace", work, prompt]


def agy_argv(prompt, root, work, sid):
    # Run with HOME set to a new directory (agy_home) that holds no MCP configuration; no permission flag, so an
    # action that needs approval is soft-denied. --settings (this session only, never saved) allows reading the copy
    # and the read-only search commands a reader uses; any other command is soft-denied. The model is the slug of the
    # level the user calls Hydrogen.
    allow = ["read_file(%s)" % root] + ["command(%s)" % c for c in ("rg", "grep", "cat", "sed", "head", "tail", "ls", "find", "wc")]
    return ["agy", "--print", prompt, "--output-format", "stream-json", "--model", "gemini-4-hydrogen-low",
            "--add-dir", root, "--settings", json.dumps({"permissions": {"allow": allow}})]


def agy_home(home):
    """A home for one agy run: links to the login token and the instruction pointers, no MCP, hook or skill file."""
    real = os.path.expanduser("~")
    os.makedirs(home + "/.gemini/antigravity-cli")
    os.symlink(real + "/.gemini/antigravity-cli/antigravity-oauth-token", home + "/.gemini/antigravity-cli/antigravity-oauth-token")
    for name in ("AGENTS.md", "GEMINI.md"):
        os.symlink("/root/.agents/AGENTS.md", home + "/.gemini/" + name)


def answer_of(reader, stream):
    """The final answer from the saved stream of events, or None."""
    text = None
    for line in stream.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        if reader == "claude-haiku" and e.get("type") == "result" and isinstance(e.get("result"), str):
            text = e["result"]
        elif reader == "muse-ember" and (e.get("payload") or {}).get("kind") == "run_terminal":
            text = e["payload"].get("text") if isinstance(e["payload"].get("text"), str) else text
        elif reader == "agy-hydrogen" and e.get("event") == "result" and isinstance((e.get("result") or {}).get("response"), str):
            text = e["result"]["response"]
    return text


# One row per reader: the CLI, its command line, its environment beyond KEEP, and whether invariant 3 lets it run.
READERS = {
    "claude-haiku": {"cli": "claude", "argv": claude_argv, "env": ("CLAUDE_CONFIG_DIR",), "runnable": True,
                     "rule": "--strict-mcp-config: no MCP server of the account starts"},
    "muse-ember": {"cli": "muse", "argv": muse_argv, "env": (), "set": {"MUSE_NO_AUTO_UPDATE": "1"}, "runnable": True,
                   "rule": "a new untrusted workspace; the session record must say MCP startup was withheld"},
    "agy-hydrogen": {"cli": "agy", "argv": agy_argv, "env": (), "home": agy_home, "runnable": True,
                     "rule": "HOME is a new directory without MCP configuration; shown by pgrep to start no MCP server"},
}


def fail(code, detail=""):
    print(json.dumps({"status": code, "detail": detail}))
    sys.exit(2)


def descendants_with_marks(root_pid):
    """Processes below root_pid whose command line holds an MCP server's mark."""
    parent, cmd = {}, {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % d) as f:
                parent[int(d)] = int(f.read().rsplit(")", 1)[1].split()[1])
            with open("/proc/%s/cmdline" % d, "rb") as f:
                cmd[int(d)] = f.read().replace(b"\0", b" ").decode(errors="replace")
        except (OSError, IndexError, ValueError):
            continue
    found = []
    for pid, line in cmd.items():
        if not any(m in line for m in MCP_MARKS):
            continue
        p, seen = pid, set()
        while p in parent and p not in seen and p > 1:
            seen.add(p)
            p = parent[p]
            if p == root_pid:
                found.append(pid)
                break
    return found


def run_case(a, row, case, out):
    """One session; its files are <out>/<id>.md (answer), .jsonl (events), .err, .json (what the run did)."""
    work = tempfile.mkdtemp(prefix="instr-")
    home = tempfile.mkdtemp(prefix="instr-home-") if row.get("home") else None
    sid = str(uuid.uuid4())
    meta = {"id": case["id"], "reader": a.reader, "session": sid, "state": None, "exit": None, "mcp_processes": [],
            "seconds": None}
    try:
        env = {k: os.environ[k] for k in KEEP + row["env"] if k in os.environ}
        env.update(row.get("set", {}))
        env["TERM"] = "dumb"
        if home:
            row["home"](home)
            env["HOME"] = home
        prompt = PROMPT.format(situation=case["situation"], root=a.root)
        argv = row["argv"](prompt, a.root, work, sid)
        start = time.time()
        with open(out + ".jsonl", "wb") as so, open(out + ".err", "wb") as se:
            try:
                p = subprocess.Popen(argv, cwd=work, env=env, stdin=subprocess.DEVNULL, stdout=so, stderr=se,
                                     start_new_session=True)
            except OSError as e:
                meta.update(state="start_failed", detail=type(e).__name__)
                return meta
            seen, stop = set(), threading.Event()

            def watch():
                while not stop.is_set():
                    seen.update(descendants_with_marks(p.pid))
                    stop.wait(0.1)
            t = threading.Thread(target=watch, daemon=True)
            t.start()
            try:
                meta["exit"] = p.wait(timeout=TIME_BOUND)
            except subprocess.TimeoutExpired:
                os.killpg(p.pid, signal.SIGKILL)
                p.wait()
                meta["state"] = "timeout"
            stop.set()
            t.join()
        meta["seconds"] = round(time.time() - start, 1)
        meta["mcp_processes"] = sorted(seen)
        with open(out + ".jsonl", encoding="utf-8", errors="replace") as f:
            answer = answer_of(a.reader, f.read())
        if answer is not None:
            with open(out + ".md", "w") as f:
                f.write(answer)
        if a.reader == "muse-ember":
            records = glob.glob(os.path.expanduser("~/.local/share/muse/sessions/*/*/*/%s/session.jsonl" % sid))
            text = "".join(open(r, encoding="utf-8", errors="replace").read() for r in records)
            meta["mcp_withheld"] = WITHHELD in text
        if meta["state"] is None:
            meta["state"] = "ok" if meta["exit"] == 0 and answer else "failed"
        return meta
    finally:
        shutil.rmtree(work, ignore_errors=True)
        if home:
            shutil.rmtree(home, ignore_errors=True)
        with open(out + ".json", "w") as f:
            json.dump(meta, f, indent=1)


def score(cases, d, reader, states):
    """The two rules over the answers saved under d."""
    result, counts = {}, {"routed": 0, "answered": 0, "both": 0, "not_run": 0}
    for c in cases:
        cid, state = c["id"], states.get(c["id"])
        path = os.path.join(d, cid + ".md")
        if state not in (None, "ok") or not os.path.isfile(path):
            result[cid] = {"state": state or "not_run", "routed": False, "answered": False}
            counts["not_run"] += 1
            continue
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
        files = [line for line in text.splitlines() if line.strip().lstrip("*_`").startswith("File:")]
        routed = bool(files) and any(name in files[-1] for name in c["files"])
        missing = [t for t in c["tokens"] if t not in text]
        result[cid] = {"state": "ok", "routed": routed, "answered": not missing, "missing": missing}
        counts["routed"] += routed
        counts["answered"] += not missing
        counts["both"] += routed and not missing
    return {"reader": reader, "cases": result, "counts": counts,
            "failing": [cid for cid, r in result.items() if not (r["routed"] and r["answered"])]}


def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    p = argparse.ArgumentParser(prog="run", allow_abbrev=False)
    p.add_argument("--root")
    p.add_argument("--reader", choices=sorted(READERS))
    p.add_argument("--out")
    p.add_argument("--case", action="append", default=[])
    p.add_argument("--score")
    p.add_argument("--jobs", type=int, default=3, help="sessions at the same time (default 3)")
    a = p.parse_args()
    with open(os.path.join(HERE, "cases.json")) as f:
        cases = json.load(f)
    known = {c["id"] for c in cases}
    if [c for c in a.case if c not in known]:
        fail("case_unknown", " ".join(c for c in a.case if c not in known))
    cases = [c for c in cases if not a.case or c["id"] in a.case]
    if a.score:
        states = {}
        for c in cases:
            m = os.path.join(a.score, c["id"] + ".json")
            if os.path.isfile(m):
                with open(m) as f:
                    meta = json.load(f)
                states[c["id"]] = meta.get("state")
                a.reader = a.reader or meta.get("reader")
        print(json.dumps(score(cases, a.score, a.reader, states), indent=1))
        return 0
    if not (a.root and a.reader and a.out):
        fail("usage", "--root, --reader and --out are required without --score")
    a.root = os.path.abspath(a.root)
    if not os.path.isfile(a.root + "/AGENTS.md") or not os.path.isdir(a.root + "/runtime-references"):
        fail("root_not_laid_out", "--root needs AGENTS.md and runtime-references/")
    row = READERS[a.reader]
    if not row["runnable"]:
        states = {c["id"]: "not_run" for c in cases}
        print(json.dumps({**score(cases, a.out, a.reader, states), "not_run_reason": row["rule"]}, indent=1))
        return 0
    if not shutil.which(row["cli"]):
        fail("cli_missing", row["cli"])
    os.makedirs(a.out, exist_ok=True)
    taken = [c["id"] for c in cases if os.path.exists(os.path.join(a.out, c["id"] + ".json"))]
    if taken:
        fail("out_exists", " ".join(taken))
    states, broke, lock = {}, [], threading.Lock()
    queue = list(cases)

    def worker():
        while True:
            with lock:
                if not queue or broke:
                    return
                c = queue.pop(0)
            m = run_case(a, row, c, os.path.join(a.out, c["id"]))
            with lock:
                states[c["id"]] = m["state"]
                if m["mcp_processes"] or m.get("mcp_withheld") is False:
                    broke.append(c["id"])  # invariant 3 did not hold: start no further session
    threads = [threading.Thread(target=worker) for _ in range(max(1, a.jobs))]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    result = score(cases, a.out, a.reader, states)
    result["start_failed"] = [cid for cid, s in states.items() if s != "ok"]
    result["mcp_rule_broken"] = broke
    print(json.dumps(result, indent=1))
    return 2 if result["start_failed"] or broke or len(states) < len(cases) else 0


if __name__ == "__main__":
    sys.exit(main())
