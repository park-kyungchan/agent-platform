#!/usr/bin/env bash
# pre-commit hook of a task repository whose STATE.md names a Lead (skill `lead`, section 7).
# Install in the task directory (the installed file needs no execute bit):
#   printf '#!/bin/sh\nexec bash /root/.agents/skills/lead/hooks/pre-commit\n' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# It refuses a commit when
#   - the STATE.md being committed is larger than 12,000 bytes (a checkpoint read at every start);
#   - the task has an executable ./measure and the block between "<!-- measure -->" and
#     "<!-- /measure -->" of that STATE.md differs from the output of ./measure run now, or
#     ./measure fails or takes more than 10 seconds. Repair: ./measure --write, git add STATE.md.
# It prints, without refusing, each staged page TASK-*.md over 6,000 bytes.
# A commit that must pass although a check refuses is `git commit --no-verify`; say why in its message.
set -uo pipefail
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
state() { git cat-file -e :STATE.md 2>/dev/null && git show :STATE.md || cat STATE.md 2>/dev/null; }
[ -f STATE.md ] || git cat-file -e :STATE.md 2>/dev/null || exit 0
fail=0
limit=${STATE_MAX_BYTES:-12000}
size=$(state | wc -c)
if [ "$size" -gt "$limit" ]; then
  echo "state_too_large@STATE.md: ${size} bytes, at most ${limit}. Replace old values; history is in Git." >&2; fail=1
fi
if [ -x ./measure ]; then
  now=$(timeout 10 ./measure 2>/dev/null); rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$now" ]; then
    echo "measure_failed@measure: exit ${rc} (124 = over 10 s) or no output" >&2; fail=1
  else
    held=$(state | awk '/^<!-- measure -->$/{f=1;next} /^<!-- \/measure -->$/{f=0} f')
    if [ -z "$held" ]; then
      echo "measure_block_missing@STATE.md: no lines between <!-- measure --> and <!-- /measure -->" >&2; fail=1
    elif [ "$held" != "$now" ]; then
      echo "measure_block_stale@STATE.md: differs from ./measure run now (< committed, > now):" >&2
      diff <(printf '%s\n' "$held") <(printf '%s\n' "$now") | grep '^[<>]' | cut -c1-200 >&2
      echo "Repair: ./measure --write && git add STATE.md" >&2; fail=1
    fi
  fi
fi
git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)TASK-[^/]*\.md$' | while IFS= read -r f; do
  s=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  [ "$s" -gt 6000 ] && echo "note: ${f} is ${s} bytes; a page over 6,000 bytes is often larger than the change it orders" >&2
done
exit $fail
