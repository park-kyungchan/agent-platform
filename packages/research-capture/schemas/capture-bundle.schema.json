{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palantirkc:research:capture-bundle:1",
  "title": "CaptureBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "captureId", "projectId", "requestedUrl", "startedAt", "retrievedAt", "adapterRevision", "upstreamRevision", "runtimeCandidate", "outcome", "attempts", "artifacts", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "captureId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "requestedUrl": { "type": "string", "pattern": "^https?://" },
    "startedAt": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "minLength": 1 },
    "adapterRevision": { "$ref": "#/$defs/hash" },
    "upstreamRevision": { "type": "string", "minLength": 1 },
    "runtimeCandidate": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["success", "partial", "failure"] },
    "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "headers": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
    "redirect": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "status", "requestHeaders", "responseHeaders"],
      "properties": {
        "url": { "type": "string", "minLength": 1 }, "status": { "type": ["integer", "null"] },
        "requestHeaders": { "$ref": "#/$defs/headers" }, "responseHeaders": { "$ref": "#/$defs/headers" }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "observedAt"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "observedAt": { "type": "string", "minLength": 1 } }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "mode", "outcome", "exitCode", "matched", "extractionPassed", "outputPath", "stdoutPath", "stderrPath", "startedAt", "finishedAt", "status", "finalUrl", "requestHeaders", "responseHeaders", "redirects", "unavailable", "diagnostics"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 }, "mode": { "enum": ["static", "dynamic"] }, "outcome": { "enum": ["success", "failure"] },
        "exitCode": { "type": ["integer", "null"] }, "matched": { "type": ["boolean", "null"] }, "extractionPassed": { "type": "boolean" }, "error": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 }, "stdoutPath": { "type": "string", "minLength": 1 }, "stderrPath": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 }, "finishedAt": { "type": "string", "minLength": 1 },
        "status": { "type": ["integer", "null"] }, "finalUrl": { "type": ["string", "null"] },
        "requestHeaders": { "$ref": "#/$defs/headers" }, "responseHeaders": { "$ref": "#/$defs/headers" },
        "redirects": { "type": ["array", "null"], "items": { "$ref": "#/$defs/redirect" } },
        "unavailable": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "reason"], "properties": { "field": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256", "byteLength", "attempt", "mode", "mediaType", "provenance", "url", "observedAt", "complete"],
      "properties": {
        "kind": { "enum": ["response-content", "rendered-dom", "extracted-text"] }, "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }, "byteLength": { "type": "integer", "minimum": 0 }, "attempt": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["static", "dynamic"] }, "mediaType": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["static-response", "same-browser-navigation", "rendered-page", "selector-extraction"] },
        "url": { "type": "string", "minLength": 1 }, "observedAt": { "type": "string", "minLength": 1 }, "complete": { "type": "boolean" }
      }
    }
  }
}
