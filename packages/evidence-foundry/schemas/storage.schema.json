{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.evidence-foundry/storage.schema.json",
  "title": "StorageRecord",
  "oneOf": [
    {
      "$ref": "#/$defs/CommitBatch"
    },
    {
      "$ref": "#/$defs/AuditRecord"
    },
    {
      "$ref": "#/$defs/BackupManifest"
    }
  ],
  "$defs": {
    "RecordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "kind",
        "id"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "object",
            "link",
            "audit"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CommitBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "sequence",
        "previousHash",
        "createdAt",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "commit"
        },
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previousHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RecordReference"
          }
        }
      }
    },
    "AuditRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "createdAt",
        "operation",
        "status",
        "details"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "audit"
        },
        "id": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "simulated",
            "interrupted"
          ]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "BackupManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "createdAt",
        "head",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "backup"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(blobs|records|commits|runs)/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
