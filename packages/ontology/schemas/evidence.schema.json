{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palantirkc.local/ontology/domains/evidence/1.0.0/evidence.schema.json",
  "title": "EvidenceProperties",
  "description": "Persisted evidence-domain property contracts. Domain entity properties remain separate from observed truth, evaluator judgment, and acceptance authority.",
  "anyOf": [
    {
      "$ref": "#/$defs/ProjectProperties"
    },
    {
      "$ref": "#/$defs/SourceCaptureProperties"
    },
    {
      "$ref": "#/$defs/ClaimProperties"
    },
    {
      "$ref": "#/$defs/VerificationUnitProperties"
    },
    {
      "$ref": "#/$defs/EvalDatasetProperties"
    },
    {
      "$ref": "#/$defs/EvalSuiteProperties"
    },
    {
      "$ref": "#/$defs/EvaluatorProperties"
    },
    {
      "$ref": "#/$defs/EvalRunProperties"
    },
    {
      "$ref": "#/$defs/CaseResultProperties"
    },
    {
      "$ref": "#/$defs/DecisionProperties"
    }
  ],
  "$defs": {
    "EvidenceJsonValue": {
      "title": "EvidenceJsonValue",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceJsonValue"
          }
        },
        {
          "$ref": "#/$defs/EvidenceJsonObject"
        }
      ]
    },
    "EvidenceJsonObject": {
      "title": "EvidenceJsonObject",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "DomainObjectType": {
      "title": "DomainObjectType",
      "type": "string",
      "enum": [
        "Project",
        "SourceCapture",
        "Claim",
        "VerificationUnit",
        "EvalDataset",
        "EvalSuite",
        "Evaluator",
        "EvalRun",
        "CaseResult",
        "Decision"
      ]
    },
    "EvidenceFingerprints": {
      "title": "EvidenceFingerprints",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "EvalMetric": {
      "title": "EvalMetric",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/EvidenceJsonValue"
        },
        "objectiveVersion": {
          "type": "string",
          "minLength": 1
        },
        "thresholdVersion": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "$ref": "#/$defs/EvidenceJsonValue"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value",
        "objectiveVersion",
        "thresholdVersion",
        "threshold",
        "passed"
      ],
      "additionalProperties": false
    },
    "CaptureArtifact": {
      "title": "CaptureArtifact",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "blobRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "ProjectProperties": {
      "title": "ProjectProperties",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domainId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "domainId"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "SourceCaptureProperties": {
      "title": "SourceCaptureProperties",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "partial"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureArtifact"
          }
        },
        "metadata": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "originalPath": {
          "type": "string"
        },
        "originalRetrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceJsonObject"
          }
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "url",
        "retrievedAt",
        "outcome",
        "artifacts",
        "metadata"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "ClaimProperties": {
      "title": "ClaimProperties",
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verificationUnitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "temporal": {
          "type": "string",
          "enum": [
            "fixed-revision",
            "current-state"
          ]
        },
        "conflictKey": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fingerprints": {
          "$ref": "#/$defs/EvidenceFingerprints"
        },
        "freshnessHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "statement",
        "verificationUnitIds",
        "temporal"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "VerificationUnitProperties": {
      "title": "VerificationUnitProperties",
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "inputSnapshot": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "expectedPredicate": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "fingerprints": {
          "$ref": "#/$defs/EvidenceFingerprints"
        },
        "temporal": {
          "type": "string",
          "enum": [
            "fixed-revision",
            "current-state"
          ]
        },
        "freshnessHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "objectiveVersion": {
          "type": "string",
          "minLength": 1
        },
        "thresholdVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "objective",
        "scope",
        "inputSnapshot",
        "expectedPredicate",
        "method"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "EvalDatasetProperties": {
      "title": "EvalDatasetProperties",
      "type": "object",
      "properties": {
        "caseRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1
        },
        "fingerprints": {
          "$ref": "#/$defs/EvidenceFingerprints"
        }
      },
      "required": [
        "caseRefs"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "EvalBudget": {
      "title": "EvalBudget",
      "type": "object",
      "properties": {
        "maxRuns": {
          "type": "integer",
          "minimum": 1
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "EvalSuiteProperties": {
      "title": "EvalSuiteProperties",
      "type": "object",
      "properties": {
        "datasetRef": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "evaluatorRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "$ref": "#/$defs/EvalBudget"
        },
        "objectiveVersion": {
          "type": "string",
          "minLength": 1
        },
        "thresholdVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "datasetRef",
        "target",
        "evaluatorRefs"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "EvaluatorProperties": {
      "title": "EvaluatorProperties",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "evaluatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "objectiveVersion": {
          "type": "string",
          "minLength": 1
        },
        "thresholdVersion": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "$ref": "#/$defs/EvidenceJsonObject"
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "EvalRunProperties": {
      "title": "EvalRunProperties",
      "type": "object",
      "properties": {
        "suiteRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "budget-exceeded"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metrics": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceJsonValue"
          }
        },
        "fingerprints": {
          "$ref": "#/$defs/EvidenceFingerprints"
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "evaluatorVersions": {
          "$ref": "#/$defs/EvidenceJsonObject"
        },
        "targetFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "suiteRef",
        "status"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "CaseResultProperties": {
      "title": "CaseResultProperties",
      "type": "object",
      "properties": {
        "runRef": {
          "type": "string",
          "minLength": 1
        },
        "unitRef": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "supported",
            "refuted",
            "insufficient"
          ]
        },
        "verificationClass": {
          "type": "string",
          "enum": [
            "deterministic-verified",
            "source-supported",
            "model-judged",
            "human-reviewed"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "error",
            "budget-exceeded"
          ]
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvalMetric"
          }
        },
        "fingerprints": {
          "$ref": "#/$defs/EvidenceFingerprints"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceJsonValue"
          }
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "evaluatorRef": {
          "type": "string",
          "minLength": 1
        },
        "evaluatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "objectiveVersion": {
          "type": "string",
          "minLength": 1
        },
        "thresholdVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "runRef",
        "unitRef",
        "verdict",
        "verificationClass"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "DecisionAuthority": {
      "title": "DecisionAuthority",
      "type": "object",
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actorId",
        "scope"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    },
    "DecisionProperties": {
      "title": "DecisionProperties",
      "type": "object",
      "properties": {
        "subjectRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "verificationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority": {
          "$ref": "#/$defs/DecisionAuthority"
        },
        "choice": {
          "$ref": "#/$defs/EvidenceJsonValue"
        }
      },
      "required": [
        "subjectRef",
        "status",
        "rationale",
        "verificationRefs",
        "authority",
        "choice"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceJsonValue"
      }
    }
  }
}
