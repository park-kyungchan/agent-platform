{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palantirkc.local/ontology/1.0.0/artifact.schema.json",
  "title": "Artifact",
  "description": "Canonical shared artifact contract. Domain-specific observations belong in details. Schema shape version is independent of package release version.",
  "oneOf": [
    {
      "$ref": "#/$defs/ProjectArtifact"
    },
    {
      "$ref": "#/$defs/TaskArtifact"
    },
    {
      "$ref": "#/$defs/ProposalArtifact"
    },
    {
      "$ref": "#/$defs/DecisionArtifact"
    },
    {
      "$ref": "#/$defs/EvidenceArtifact"
    },
    {
      "$ref": "#/$defs/VerificationArtifact"
    },
    {
      "$ref": "#/$defs/RunArtifact"
    }
  ],
  "$defs": {
    "JsonValue": {
      "title": "JsonValue",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "$ref": "#/$defs/JsonObject"
        }
      ]
    },
    "JsonObject": {
      "title": "JsonObject",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "ArtifactEnvelope": {
      "title": "ArtifactEnvelope",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "task",
            "proposal",
            "decision",
            "evidence",
            "verification",
            "run"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "domainId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "parent",
                  "supports",
                  "authorizes",
                  "implements",
                  "verifies",
                  "supersedes",
                  "derivedFrom",
                  "attemptOf",
                  "accepts"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifactId",
              "relation"
            ],
            "additionalProperties": false
          }
        },
        "payload": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "ProjectPayload": {
      "title": "ProjectPayload",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ],
          "type": "string"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "ontologyPackage": {
          "type": "object",
          "properties": {
            "name": {
              "const": "@palantirkc/ontology",
              "type": "string"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name",
        "status",
        "scope",
        "ontologyPackage",
        "commands"
      ],
      "additionalProperties": false
    },
    "TaskPayload": {
      "title": "TaskPayload",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "complete",
            "blocked",
            "cancelled"
          ],
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "verificationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "title",
        "objective",
        "status",
        "acceptanceCriteria"
      ],
      "additionalProperties": false
    },
    "ProposalPayload": {
      "title": "ProposalPayload",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "proposed",
            "withdrawn"
          ],
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "title",
        "status",
        "recommendation",
        "alternatives",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "DecisionPayload": {
      "title": "DecisionPayload",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "superseded"
          ],
          "type": "string"
        },
        "choice": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "proposalRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
        },
        "authority": {
          "type": "object",
          "properties": {
            "actorType": {
              "type": "string",
              "enum": [
                "user",
                "project-owner"
              ]
            },
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "sourceEvidenceRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actorType",
            "actorId",
            "sourceEvidenceRef",
            "scope"
          ],
          "additionalProperties": false
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "title",
        "status",
        "choice",
        "rationale",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "EvidencePayload": {
      "title": "EvidencePayload",
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "upstreamRevision": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "success",
                "failure",
                "partial"
              ]
            },
            "processExitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "contentMatched": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "details": {
              "$ref": "#/$defs/JsonObject"
            }
          },
          "required": [
            "outcome",
            "processExitCode",
            "contentMatched"
          ],
          "additionalProperties": false
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "success",
                  "failure"
                ]
              },
              "error": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "$ref": "#/$defs/JsonObject"
              }
            },
            "required": [
              "attempt",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "claim",
        "method",
        "sourceUrl",
        "fetchedAt",
        "result",
        "attempts",
        "limitations"
      ],
      "additionalProperties": false
    },
    "VerificationPayload": {
      "title": "VerificationPayload",
      "type": "object",
      "properties": {
        "targetRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "unverified"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "status",
              "message",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        },
        "inputHashes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "targetRefs",
        "criteria",
        "inputHashes",
        "runtime"
      ],
      "additionalProperties": false
    },
    "RunPayload": {
      "title": "RunPayload",
      "type": "object",
      "properties": {
        "taskRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputHashes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "verificationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:(project|task|proposal|decision|evidence|verification|run):[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "taskRef",
        "state",
        "startedAt",
        "finishedAt",
        "inputHashes",
        "runtime",
        "evidenceRefs",
        "verificationRefs"
      ],
      "additionalProperties": false
    },
    "ProjectArtifact": {
      "title": "ProjectArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "project",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/ProjectPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "TaskArtifact": {
      "title": "TaskArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "task",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/TaskPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "ProposalArtifact": {
      "title": "ProposalArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "proposal",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/ProposalPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "DecisionArtifact": {
      "title": "DecisionArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "decision",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/DecisionPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "EvidenceArtifact": {
      "title": "EvidenceArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "evidence",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/EvidencePayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "VerificationArtifact": {
      "title": "VerificationArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "verification",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/VerificationPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "RunArtifact": {
      "title": "RunArtifact",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/schemaVersion"
        },
        "kind": {
          "const": "run",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/id"
        },
        "projectId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/projectId"
        },
        "domainId": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/domainId"
        },
        "createdAt": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/createdAt"
        },
        "references": {
          "$ref": "#/$defs/ArtifactEnvelope/properties/references"
        },
        "payload": {
          "$ref": "#/$defs/RunPayload"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "projectId",
        "domainId",
        "createdAt",
