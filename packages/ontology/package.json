{
  "name": "@palantirkc/ontology-source",
  "version": "0.2.0",
  "description": "Shared schema-first artifact contracts and scoped runtime validation.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./upper": {
      "types": "./dist/upper.d.ts",
      "import": "./dist/upper.js"
    },
    "./operational": {
      "types": "./dist/operational.d.ts",
      "import": "./dist/operational.js"
    },
    "./domains/evidence": {
      "types": "./dist/domains/evidence.d.ts",
      "import": "./dist/domains/evidence.js"
    },
    "./domains/research": {
      "types": "./dist/domains/research.d.ts",
      "import": "./dist/domains/research.js"
    },
    "./domains/native-harness": {
      "types": "./dist/domains/native-harness.d.ts",
      "import": "./dist/domains/native-harness.js"
    },
    "./schemas/artifact.schema.json": "./schemas/artifact.schema.json",
    "./schemas/operational.schema.json": "./schemas/operational.schema.json",
    "./schemas/evidence.schema.json": "./schemas/evidence.schema.json",
    "./package.json": "./package.json",
    "./generate": "./scripts/generate.ts",
    "./internal/contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./internal/domains/evidence": {
      "types": "./dist/domains/evidence.d.ts",
      "import": "./dist/domains/evidence.js"
    },
    "./internal/domains/native-harness": {
      "types": "./dist/domains/native-harness.d.ts",
      "import": "./dist/domains/native-harness.js"
    },
    "./internal/domains/research": {
      "types": "./dist/domains/research.d.ts",
      "import": "./dist/domains/research.js"
    },
    "./internal/generated/contracts": {
      "types": "./dist/generated/contracts.d.ts",
      "import": "./dist/generated/contracts.js"
    },
    "./internal/generated/evidence": {
      "types": "./dist/generated/evidence.d.ts",
      "import": "./dist/generated/evidence.js"
    },
    "./internal/generated/operational": {
      "types": "./dist/generated/operational.d.ts",
      "import": "./dist/generated/operational.js"
    },
    "./internal/index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/json-validation": {
      "types": "./dist/json-validation.d.ts",
      "import": "./dist/json-validation.js"
    },
    "./internal/operational-validation": {
      "types": "./dist/operational-validation.d.ts",
      "import": "./dist/operational-validation.js"
    },
    "./internal/operational": {
      "types": "./dist/operational.d.ts",
      "import": "./dist/operational.js"
    },
    "./internal/schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./internal/upper": {
      "types": "./dist/upper.d.ts",
      "import": "./dist/upper.js"
    },
    "./internal/validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "ontology",
    "scripts/generate.ts",
    "AGENTS.md"
  ],
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "bun run generate:check && bun run typecheck && tsc -p tsconfig.build.json",
    "check": "bun run generate:check && tsc --noEmit && bun test tests"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
