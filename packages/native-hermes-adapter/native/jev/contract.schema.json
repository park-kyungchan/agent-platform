{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palantirkc:jev:semantic-request:versioned",
  "title": "Versioned native Jev semantic request",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "v1": {
      "title": "Native Jev semantic request from admitted host Root or child caller",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "requestId",
        "model",
        "purpose",
        "stateDigest",
        "state",
        "questions",
        "scope"
      ],
      "properties": {
        "schema": {
          "const": "jev.semantic-request.v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "model": {
          "const": "typesafe-ai/jev-1.14.0"
        },
        "purpose": {
          "const": "semantic_bundle"
        },
        "stateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Host-computed opaque semantic-state digest. Exact submittedRequestSha256 binds actual transport bytes across languages."
        },
        "state": {
          "type": "object",
          "required": ["requiredContext", "binding", "facts"],
          "properties": {
            "requiredContext": {
              "type": "object",
              "required": [
                "currentAuthority",
                "wholeObjective",
                "taskGoal",
                "acceptedWhy",
                "acceptedDecisions",
                "owners",
                "dependencies",
                "completedEffectRefs",
                "uncertainEffectRefs",
                "remainingAcceptance"
              ],
              "properties": {
                "currentAuthority": {
                  "type": "object",
                  "required": ["text", "sourceRefs"],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12000
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  }
                },
                "wholeObjective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "taskGoal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "acceptedWhy": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["text", "attribution", "sourceRefs"],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "attribution": {
                        "enum": ["current-user", "historical", "inference"]
                      },
                      "sourceRefs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    }
                  }
                },
                "acceptedDecisions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "revision", "sourceRefs"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "revision": {
                        "type": ["string", "number"]
                      },
                      "sourceRefs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "owners": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["role", "id"],
                    "properties": {
                      "role": {
                        "enum": ["native", "source", "domain", "data"]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      }
                    }
                  }
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "revision", "currentness"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "revision": {
                        "type": ["string", "null"]
                      },
                      "currentness": {
                        "enum": ["current", "stale", "unknown"]
                      }
                    }
                  }
                },
                "completedEffectRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "uncertainEffectRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "remainingAcceptance": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "binding": {
              "type": "object"
            },
            "facts": {
              "type": "object"
            }
          }
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions"],
                "properties": {
                  "type": {
                    "const": "noul"
                  },
                  "instructions": {
                    "type": ["string", "object", "array"]
                  },
                  "criteria": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions", "criteria"],
                "properties": {
                  "type": {
                    "const": "choice"
                  },
                  "instructions": {
                    "type": ["string", "object", "array"]
                  },
                  "criteria": {
                    "type": "object",
                    "minProperties": 2,
                    "maxProperties": 32,
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "agentId",
            "agentType",
            "taskGoal",
            "wholeObjective",
            "why",
            "owners"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
            },
            "agentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agentType": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "taskGoal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "wholeObjective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "why": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "owners": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      },
      "description": "At most65536 incoming UTF8 bytes. Native serialized model HTTP body is bounded to49152bytes before network; shared accounting requires pinned known-model pricing and sufficient conservative reservation. Typed judgments never grant native permission or task completion."
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "requestId",
        "model",
        "purpose",
        "stateDigest",
        "state",
        "questions",
        "scope",
        "consumptionPolicy",
        "imageOptIn"
      ],
      "properties": {
        "schema": {
          "const": "jev.semantic-request.v2"
        },
        "requestId": {
          "$ref": "#/$defs/v1/properties/requestId"
        },
        "model": {
          "$ref": "#/$defs/v1/properties/model"
        },
        "purpose": {
          "$ref": "#/$defs/v1/properties/purpose"
        },
        "stateDigest": {
          "$ref": "#/$defs/v1/properties/stateDigest"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/v1/properties/state"
            },
            {
              "type": "object",
              "properties": {
                "directBoundary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["opportunity", "actions", "boxes", "imageEvidence"],
                  "properties": {
                    "opportunity": {
                      "type": "object"
                    },
                    "actions": {
                      "type": "array",
                      "maxItems": 31
                    },
                    "boxes": {
                      "type": "object"
                    },
                    "imageEvidence": {
                      "type": "object"
                    }
                  }
                },
                "semanticBoundary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "mode",
                    "executionAuthorityGranted",
                    "automaticWrite",
                    "workerCompletionVerified"
                  ],
                  "properties": {
                    "schema": {
                      "const": "jev.semantic-boundary.v2"
                    },
                    "mode": {
                      "const": "advice-only"
                    },
                    "executionAuthorityGranted": {
                      "const": false
                    },
                    "automaticWrite": {
                      "const": false
                    },
                    "workerCompletionVerified": {
                      "const": false
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": ["directBoundary"],
                  "not": {
                    "required": ["semanticBoundary"]
                  }
                },
                {
                  "required": ["semanticBoundary"],
                  "not": {
                    "required": ["directBoundary"]
                  }
                }
              ]
            }
          ]
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": {
            "$ref": "#/$defs/directIdentifier"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions"],
                "properties": {
                  "type": {
                    "const": "noul"
                  },
                  "instructions": {
                    "$ref": "#/$defs/content"
                  },
                  "criteria": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "true": {
                        "$ref": "#/$defs/content"
                      },
                      "false": {
                        "$ref": "#/$defs/content"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions", "criteria"],
                "properties": {
                  "type": {
                    "const": "choice"
                  },
                  "instructions": {
                    "$ref": "#/$defs/content"
                  },
                  "criteria": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 255,
                    "propertyNames": {
                      "$ref": "#/$defs/directIdentifier"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/content"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions", "criteria"],
                "properties": {
                  "type": {
                    "const": "score"
                  },
                  "instructions": {
                    "$ref": "#/$defs/content"
                  },
                  "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "$ref": "#/$defs/level"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "instructions"],
                "properties": {
                  "type": {
                    "const": "box"
                  },
                  "instructions": {
                    "$ref": "#/$defs/content"
                  }
                }
              }
            ]
          }
        },
        "scope": {
          "$ref": "#/$defs/v1/properties/scope"
        },
        "consumptionPolicy": {
          "const": "jev.direct-selected-answer.v2"
        },
        "imageOptIn": {
          "type": "boolean"
        },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/directIdentifier"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "format", "data_base64"],
                "properties": {
                  "type": {
                    "const": "image"
                  },
                  "format": {
                    "enum": ["png", "jpg", "jpeg"]
                  },
                  "data_base64": {
                    "type": "string",
                    "minLength": 4,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "part"],
                "properties": {
                  "type": {
                    "const": "image"
                  },
                  "part": {
                    "$ref": "#/$defs/directIdentifier"
                  },
                  "format": {
                    "enum": ["png", "jpg", "jpeg"]
                  }
                }
              }
            ]
          }
        }
      },
      "description": "Structural admission only. Exactly one directBoundary or exact advice-only semanticBoundary. Semantic requests are text only with imageOptIn false and no assets/Box. Runtime validates the canonical state digest and existing direct image bindings. Pinned owner client subsets and native permissions remain separate.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "required": ["semanticBoundary"]
              }
            }
          },
          "then": {
            "properties": {
              "imageOptIn": {
                "const": false
              },
              "questions": {
                "additionalProperties": {
                  "properties": {
                    "type": {
                      "not": {
                        "const": "box"
                      }
                    }
                  }
                }
              }
            },
            "not": {
              "required": ["assets"]
            }
          }
        }
      ]
    },
    "content": {
      "type": ["string", "object", "array", "null"]
    },
    "level": {
      "type": ["string", "object", "array"]
    },
    "directIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f]+$",
      "not": {
        "enum": ["__proto__", "constructor", "prototype"]
      }
    }
  },
  "description": "v1 retains its original parser/client behavior and 2..32 Choice contract. v2 follows the common direct selected-answer policy, retaining original raw typed answers without confidence/tie vetoes. Both remain bounded to65536 incoming bytes,49152 wire bytes,24questions and one existing owner transport/lease; no retry or new client."
}
