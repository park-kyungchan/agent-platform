{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palantirkc:jev:semantic-request:v1",
  "title": "Native Jev semantic request from admitted host Root or child caller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "model",
    "purpose",
    "stateDigest",
    "state",
    "questions",
    "scope"
  ],
  "properties": {
    "schema": {
      "const": "jev.semantic-request.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "model": {
      "const": "typesafe-ai/jev-1.14.0"
    },
    "purpose": {
      "const": "semantic_bundle"
    },
    "stateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Host-computed opaque semantic-state digest. Exact submittedRequestSha256 binds actual transport bytes across languages."
    },
    "state": {
      "type": "object",
      "required": ["requiredContext", "binding", "facts"],
      "properties": {
        "requiredContext": {
          "type": "object",
          "required": [
            "currentAuthority",
            "wholeObjective",
            "taskGoal",
            "acceptedWhy",
            "acceptedDecisions",
            "owners",
            "dependencies",
            "completedEffectRefs",
            "uncertainEffectRefs",
            "remainingAcceptance"
          ],
          "properties": {
            "currentAuthority": {
              "type": "object",
              "required": ["text", "sourceRefs"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            },
            "wholeObjective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "taskGoal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "acceptedWhy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["text", "attribution", "sourceRefs"],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "attribution": {
                    "enum": ["current-user", "historical", "inference"]
                  },
                  "sourceRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "acceptedDecisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "revision", "sourceRefs"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "revision": {
                    "type": ["string", "number"]
                  },
                  "sourceRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "owners": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["role", "id"],
                "properties": {
                  "role": {
                    "enum": ["native", "source", "domain", "data"]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  }
                }
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "revision", "currentness"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "revision": {
                    "type": ["string", "null"]
                  },
                  "currentness": {
                    "enum": ["current", "stale", "unknown"]
                  }
                }
              }
            },
            "completedEffectRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertainEffectRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remainingAcceptance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "binding": {
          "type": "object"
        },
        "facts": {
          "type": "object"
        }
      }
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "instructions"],
            "properties": {
              "type": {
                "const": "noul"
              },
              "instructions": {
                "type": ["string", "object", "array"]
              },
              "criteria": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "instructions", "criteria"],
            "properties": {
              "type": {
                "const": "choice"
              },
              "instructions": {
                "type": ["string", "object", "array"]
              },
              "criteria": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 32,
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "agentId",
        "agentType",
        "taskGoal",
        "wholeObjective",
        "why",
        "owners"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "agentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agentType": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskGoal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "wholeObjective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "description": "At most65536 incoming UTF8 bytes. Native serialized model HTTP body is bounded to49152bytes before network; shared accounting requires pinned known-model pricing and sufficient conservative reservation. Typed judgments never grant native permission or task completion."
}
