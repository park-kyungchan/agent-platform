font_tuple_valid() {
  [[ "$1" == "$FONT_SOURCE_SHA" && "$2" == 1 && "$3" == "$FONT_RELEASE_TAG" && "$4" == "$FONT_PATCH_SHA" ]]
}
font_request_valid() {
  [[ "${FONT_READABILITY:-0}" == 1 && "${OVERLAY_MODE:-0}" == 1 ]] && font_tuple_valid "$1" "${BOT_DESKTOP:-0}" "${RELEASE_TAG:-}" "$2"
}
font_dockerfile_valid() {
  [[ -f "$WORKTREE/Dockerfile" && ! -L "$WORKTREE/Dockerfile" ]] && [[ "$(sha256sum -- "$WORKTREE/Dockerfile" | awk '{print $1}')" == "$1" ]]
}
