  "object_types": {
    "task": {
      "description": "One task directory under /home/palantirkc/work with its STATE.md.",
      "owner": {
        "source": "task_states"
      },
      "primary_key": {
        "from": "/dir"
      },
      "title": "title_line",
      "properties": {
        "directory": {
          "type": "string",
          "required": true,
          "from": "/dir_path"
        },
        "state_sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "owner_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Owner"
        }
      }
    },
    "packet": {
      "description": "One TASK*.md file under /home/palantirkc/work at directory depth 1 to 3; the key is the path below the work root.",
      "owner": {
        "source": "packets"
      },
      "primary_key": {
        "from": "/path",
        "transform": {
          "replace_prefix": [
            "/home/palantirkc/work/",
            ""
          ]
        }
      },
      "title": "title_line",
      "properties": {
        "path": {
          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "owner_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Owner"
        },
        "state_line": {
          "type": "string",
          "required": false,
          "from": "/fields/State"
        },
        "task": {
          "type": {
            "ref": "task"
          },
          "required": false,
          "from": "/path",
          "transform": {
            "segment_after": "/home/palantirkc/work/"
          }
        }
      }
    },
    "report": {
      "description": "One REPORT*.md file under /home/palantirkc/work at directory depth 1 to 3; the key is the path below the work root.",
      "owner": {
        "source": "reports"
      },
      "primary_key": {
        "from": "/path",
        "transform": {
          "replace_prefix": [
            "/home/palantirkc/work/",
            ""
          ]
        }
      },
      "title": "title_line",
      "properties": {
        "path": {
          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "status_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Status"
        },
        "task": {
          "type": {
            "ref": "task"
          },
          "required": false,
          "from": "/path",
          "transform": {
            "segment_after": "/home/palantirkc/work/"
          }
        },
        "packet": {
          "type": {
            "ref": "packet"
          },
          "required": false,
          "template": "{dir_path}/TASK-{stem_id}.md",
          "transform": {
            "replace_prefix": [
              "/home/palantirkc/work/",
              ""
            ]
          }
        }
      }
    },
    "installed_artifact": {
      "description": "One installed binary under /usr/local/bin; an absent file has no object.",
      "owner": {
        "source": "installed_binaries"
      },
      "primary_key": {
        "from": "/path"
      },
      "title": "path",
      "properties": {
        "path": {
          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "size": {
          "type": "integer",
          "required": true,
          "from": "/size"
        },
        "mtime": {
          "type": "integer",
          "required": true,
          "from": "/mtime"
        },
        "mode": {
          "type": "integer",
          "required": true,
          "from": "/mode"
        }
      }
    },
    "instruction_file": {
      "description": "One shared instruction file: installed under /root/.agents or its source under agent-platform/content.",
      "owner": {
        "source": "instructions"
      },
      "primary_key": {
        "from": "/path"
      },
      "title": "path",
      "properties": {
        "path": {
          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "size": {
          "type": "integer",
          "required": true,
          "from": "/size"
        },
        "mtime": {
          "type": "integer",
          "required": true,
          "from": "/mtime"
        },
        "mode": {
          "type": "integer",
          "required": true,
          "from": "/mode"
        },
        "source_copy": {
          "type": {
            "ref": "instruction_file"
          },
          "required": false,
          "from": "/path",
          "transform": {
            "replace_prefix": [
              "/root/.agents/",
              "/home/palantirkc/platforms/agent-platform/content/"
            ]
          }
        }
      }
    }
  },
  "link_types": {
    "packet_task": {
      "from": "packet",
      "via": "task",
      "to": "task",
      "cardinality": "many_to_one",
      "names": {
        "forward": "task",
        "reverse": "packets"
      }
    },
    "report_task": {
      "from": "report",
      "via": "task",
      "to": "task",
      "cardinality": "many_to_one",
      "names": {
        "forward": "report_task",
        "reverse": "reports"
      }
    },
    "report_packet": {
      "from": "report",
      "via": "packet",
      "to": "packet",
      "cardinality": "many_to_one",
      "names": {
        "forward": "packet",
        "reverse": "packet_reports"
      }
    },
    "source_copy": {
      "from": "instruction_file",
      "via": "source_copy",
      "to": "instruction_file",
      "cardinality": "many_to_one",
      "names": {
        "forward": "source_copy",
        "reverse": "installed_copies"
      }
    }
  },
  "action_types": {},
  "functions": {},
  "grants": [
    {
      "principal": "agent",
      "scope": {},
      "read": [
        "task",
        "packet",
        "report",
        "installed_artifact",
        "instruction_file"
      ],
      "derive": [],
      "actions": []
    }
  ]
