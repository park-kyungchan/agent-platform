            "task_directory": "$task_directory",
            "name": "$name",
            "tier": "$tier",
            "runtime": "$runtime",
            "session": "$session",
            "packet_path": "$packet_path",
            "started_at": "$started_at",
            "status": "running"
          }
        }
      ]
    },
    "note_worker_run": {
      "description": "Record result (a progress note) on worker_run (a running worker reference).",
