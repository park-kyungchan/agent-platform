  "object_types": {
    "task": {
      "description": "One task directory under /home/palantirkc/work with its STATE.md; key is the directory name. Properties (property descriptions are not supported by the schema language): directory is the full path of the directory; state_sha256 is the sha256 of STATE.md; title_line is the first line of STATE.md and owner_line the text after Owner: in its first 40 lines (both copied as written, may be long, owner_line may have no value).",
      "owner": {
        "source": "task_states"
      },
      "primary_key": {
        "from": "/dir"
      },
      "title": "title_line",
      "properties": {
        "directory": {
          "type": "string",
          "required": true,
          "from": "/dir_path"
        },
        "state_sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "owner_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Owner"
        }
      }
    },
    "packet": {
      "description": "One TASK*.md file under /home/palantirkc/work at directory depth 1 to 3; key is the path below the work root. Properties: path is the full path, sha256 the file digest, title_line the first line and owner_line / state_line the text after Owner: / State: in the first 40 lines (copied as written, may be long, may have no value); task points to the task whose directory name is the first directory below the work root. A reference has two special states. No value: the rule could not build a key (for example a report named REPORT.md has no packet id). The target may not exist as an object: the packet file has another name, or the directory has no STATE.md.",
      "owner": {
        "source": "packets"
      },
      "primary_key": {
        "from": "/path",
        "transform": {
          "replace_prefix": [
            "/home/palantirkc/work/",
            ""
          ]
        }
      },
      "title": "title_line",
      "properties": {
        "path": {
          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "owner_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Owner"
        },
        "state_line": {
          "type": "string",
          "required": false,
          "from": "/fields/State"
        },
        "task": {
          "type": {
            "ref": "task"
          },
          "required": false,
          "from": "/path",
          "transform": {
            "segment_after": "/home/palantirkc/work/"
          }
        }
      }
    },
    "report": {
      "description": "One REPORT*.md file under /home/palantirkc/work at directory depth 1 to 3; key is the path below the work root. Properties: path is the full path, sha256 the file digest, title_line the first line and status_line the text after Status: in the first 40 lines (copied as written, may be long, may have no value); task points to the task of the first directory below the work root; packet points to TASK-<id>.md in the same directory for a file named REPORT-<id>.md (exact, no fallback in version 1). A reference has two special states. No value: the rule could not build a key (for example a report named REPORT.md has no packet id). The target may not exist as an object: the packet file has another name, or the directory has no STATE.md.",
      "owner": {
        "source": "reports"
      },
      "primary_key": {
        "from": "/path",
        "transform": {
          "replace_prefix": [
            "/home/palantirkc/work/",
