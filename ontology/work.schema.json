          "type": "string",
          "required": true,
          "from": "/path"
        },
        "sha256": {
          "type": "string",
          "required": true,
          "from": "/sha256"
        },
        "title_line": {
          "type": "string",
          "required": true,
          "from": "/line1"
        },
        "status_line": {
          "type": "string",
          "required": false,
          "from": "/fields/Status"
        },
        "task": {
          "type": {
            "ref": "task"
          },
          "required": false,
          "from": "/path",
          "transform": {
            "segment_after": "/home/palantirkc/work/"
          }
        },
        "packet": {
          "type": {
            "ref": "packet"
          },
          "required": false,
          "template": "{dir_path}/TASK-{stem_id}.md",
          "transform": {
            "replace_prefix": [
              "/home/palantirkc/work/",
              ""
            ]
          }
        }
      }
    },
    "installed_artifact": {
      "description": "One installed binary under /usr/local/bin; four paths are declared and only those that exist become objects. Properties: path, sha256, size in bytes, mtime in seconds and mode (permission bits) of the file.",
      "owner": {
