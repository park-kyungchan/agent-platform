        "/home/palantirkc/work/*/*/target*",
        "/home/palantirkc/work/*/*/*custody*",
        "/home/palantirkc/work/ws-replan/preparation/slices"
      ],
      "head_lines": 40,
      "complete_listing": true,
      "fresh_for_s": 3600
    },
    "reports": {
      "kind": "markdown_fields",
      "glob": [
        "/home/palantirkc/work/*/REPORT*.md",
        "/home/palantirkc/work/*/*/REPORT*.md",
        "/home/palantirkc/work/*/*/*/REPORT*.md"
      ],
      "exclude": [
        "/home/palantirkc/work/ws-daniel-prayer-login",
        "/home/palantirkc/work/problem-edit/context",
        "/home/palantirkc/work/problem-edit/runs",
        "/home/palantirkc/work/wt",
        "/home/palantirkc/work/*private*",
        "/home/palantirkc/work/node_modules",
