  "action_types": {
    "set_hold": {
      "description": "Record a hold: task is the task reference, task_directory its directory, effect the blocked change and until the condition for lifting it.",
      "parameters": {
        "task": {
          "type": {
            "ref": "task"
          },
          "required": true
        },
        "task_directory": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "effect": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "until": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        }
      },
      "submission_criteria": [
        {
          "code": "task_directory_mismatch",
          "message": "Read task and pass task_directory equal to task.directory.",
          "all": [
            {
              "exists": "$task"
            },
            {
              "eq": [
                "$task.directory",
                "$task_directory"
              ]
            }
          ]
        },
        {
          "code": "duplicate_active_hold",
          "message": "Lift the existing active hold on this effect before recording another.",
          "none": [
            {
              "linked": {
                "from": "$task",
                "link": "holds",
                "where": {
                  "all": [
                    {
                      "eq": [
                        "effect",
                        "$effect"
                      ]
                    },
                    {
                      "eq": [
                        "status",
                        "active"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ],
      "rules": [
        {
          "create_object": "hold",
          "set": {
            "task": "$task",
            "task_directory": "$task_directory",
            "effect": "$effect",
            "until": "$until",
            "status": "active"
          }
        }
      ]
    },
    "lift_hold": {
      "description": "Lift hold (a hold reference); reason explains why its condition is satisfied.",
      "parameters": {
        "hold": {
          "type": {
            "ref": "hold"
          },
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        }
      },
      "submission_criteria": [
        {
          "code": "hold_not_active",
          "message": "Read hold and choose one whose status is active.",
          "all": [
            {
              "eq": [
                "$hold.status",
                "active"
              ]
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "hold",
          "set": {
            "status": "lifted",
            "lift_reason": "$reason"
          }
        }
      ]
    },
    "record_decision": {
      "description": "Record a decision: task and task_directory identify its task, topic names the current decision, text states it, decided_by is user or lead, reason explains it and undo states its reversal.",
      "parameters": {
        "task": {
          "type": {
            "ref": "task"
          },
          "required": true
        },
        "task_directory": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "topic": {
          "type": "string",
          "required": true,
          "max_bytes": 120
        },
        "text": {
          "type": "string",
          "required": true,
          "max_bytes": 1000
        },
        "decided_by": {
          "type": {
            "value_type": "decision_actor"
          },
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true,
          "max_bytes": 600
        },
        "undo": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        }
      },
      "submission_criteria": [
        {
          "code": "task_directory_mismatch",
          "message": "Read task and pass task_directory equal to task.directory.",
          "all": [
            {
              "exists": "$task"
            },
            {
              "eq": [
                "$task.directory",
                "$task_directory"
              ]
            }
          ]
        },
        {
          "code": "decision_already_current",
          "message": "Use supersede_decision with the current decision reference for this topic.",
          "none": [
            {
              "linked": {
                "from": "$task",
                "link": "decisions",
                "where": {
                  "all": [
                    {
                      "eq": [
                        "topic",
                        "$topic"
                      ]
                    },
                    {
                      "eq": [
                        "status",
                        "current"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ],
      "rules": [
        {
          "create_object": "decision",
          "set": {
            "task": "$task",
            "task_directory": "$task_directory",
            "topic": "$topic",
            "text": "$text",
            "decided_by": "$decided_by",
            "reason": "$reason",
            "undo": "$undo",
            "status": "current"
          }
        }
      ]
    },
    "supersede_decision": {
      "description": "Replace decision (a current decision reference): task, task_directory and topic must repeat its values; text is the new decision, decided_by its user or lead author, reason its basis and undo its reversal.",
      "parameters": {
        "decision": {
          "type": {
            "ref": "decision"
          },
          "required": true
        },
        "task": {
          "type": {
            "ref": "task"
          },
          "required": true
        },
        "task_directory": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "topic": {
          "type": "string",
          "required": true,
          "max_bytes": 120
        },
        "text": {
          "type": "string",
          "required": true,
          "max_bytes": 1000
        },
        "decided_by": {
          "type": {
            "value_type": "decision_actor"
          },
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true,
          "max_bytes": 600
        },
        "undo": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        }
      },
      "submission_criteria": [
        {
          "code": "decision_not_current",
          "message": "Read decision and choose one whose status is current.",
          "all": [
            {
              "eq": [
                "$decision.status",
                "current"
              ]
            }
          ]
        },
        {
          "code": "task_directory_mismatch",
          "message": "Read task and pass task_directory equal to task.directory.",
          "all": [
            {
              "exists": "$task"
            },
            {
              "eq": [
                "$task.directory",
                "$task_directory"
              ]
            }
          ]
        },
        {
          "code": "decision_context_mismatch",
          "message": "Read decision and pass its task, task_directory and topic unchanged.",
          "all": [
            {
              "eq": [
                "$decision.task",
                "$task"
              ]
            },
            {
              "eq": [
                "$decision.topic",
                "$topic"
              ]
            },
            {
              "eq": [
                "$decision.task_directory",
                "$task_directory"
              ]
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "decision",
          "set": {
            "status": "superseded"
          }
        },
        {
          "create_object": "decision",
          "set": {
            "task": "$task",
            "task_directory": "$task_directory",
            "topic": "$topic",
            "text": "$text",
            "decided_by": "$decided_by",
            "reason": "$reason",
            "undo": "$undo",
            "status": "current",
            "supersedes": "$decision"
          }
        }
      ]
    },
    "define_kpi": {
      "description": "Define a KPI: task and task_directory identify its task, name is unique there, definition states what is counted and from which source, and target is the desired value.",
      "parameters": {
        "task": {
          "type": {
            "ref": "task"
          },
          "required": true
        },
        "task_directory": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "name": {
          "type": "string",
          "required": true,
          "max_bytes": 120
        },
        "definition": {
          "type": "string",
          "required": true,
          "max_bytes": 600
        },
        "target": {
          "type": "string",
          "required": true,
          "max_bytes": 200
        }
      },
      "submission_criteria": [
        {
          "code": "task_directory_mismatch",
          "message": "Read task and pass task_directory equal to task.directory.",
          "all": [
            {
              "exists": "$task"
            },
            {
              "eq": [
                "$task.directory",
                "$task_directory"
              ]
            }
          ]
        },
        {
          "code": "duplicate_kpi",
          "message": "Use the existing KPI; change its target with set_kpi_target or record a value with record_measurement.",
          "none": [
            {
              "linked": {
                "from": "$task",
                "link": "kpis",
                "where": {
                  "all": [
                    {
                      "eq": [
                        "name",
                        "$name"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ],
      "rules": [
        {
          "create_object": "kpi",
          "set": {
            "task": "$task",
            "task_directory": "$task_directory",
            "name": "$name",
            "definition": "$definition",
            "target": "$target"
          }
        }
      ]
    },
    "record_measurement": {
      "description": "Record a value: kpi is its KPI reference, value the measured text, observed_at its observation time and evidence the path or command proving it; also update the current KPI fields.",
      "parameters": {
        "kpi": {
          "type": {
            "ref": "kpi"
          },
          "required": true
        },
        "value": {
          "type": "string",
          "required": true,
          "max_bytes": 200
        },
        "observed_at": {
          "type": "string",
          "required": true,
          "max_bytes": 40
        },
        "evidence": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        }
      },
      "submission_criteria": [],
      "rules": [
        {
          "create_object": "measurement",
          "set": {
            "kpi": "$kpi",
            "value": "$value",
            "observed_at": "$observed_at",
            "evidence": "$evidence"
          }
        },
        {
          "modify_object": "kpi",
          "set": {
            "value": "$value",
            "observed_at": "$observed_at",
            "evidence": "$evidence"
          }
        }
      ]
    },
    "set_kpi_target": {
      "description": "Set target (the desired value text) on kpi (a KPI reference).",
      "parameters": {
        "kpi": {
          "type": {
            "ref": "kpi"
          },
          "required": true
        },
        "target": {
          "type": "string",
          "required": true,
          "max_bytes": 200
        }
      },
      "submission_criteria": [],
      "rules": [
        {
          "modify_object": "kpi",
          "set": {
            "target": "$target"
          }
        }
      ]
    },
    "start_worker_run": {
      "description": "Start a worker: task and task_directory identify its task, name identifies the run, tier its judgment level, runtime the CLI, session its session id, packet_path its assignment and started_at its start time.",
      "parameters": {
        "task": {
          "type": {
            "ref": "task"
          },
          "required": true
        },
        "task_directory": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "name": {
          "type": "string",
          "required": true,
          "max_bytes": 80
        },
        "tier": {
          "type": {
            "value_type": "worker_tier"
          },
          "required": true
        },
        "runtime": {
          "type": "string",
          "required": true,
          "max_bytes": 120
        },
        "session": {
          "type": "string",
          "required": true,
          "max_bytes": 200
        },
        "packet_path": {
          "type": "string",
          "required": true,
          "max_bytes": 300
        },
        "started_at": {
          "type": "string",
          "required": true,
          "max_bytes": 40
        }
      },
      "submission_criteria": [
        {
          "code": "task_directory_mismatch",
          "message": "Read task and pass task_directory equal to task.directory.",
          "all": [
            {
              "exists": "$task"
            },
            {
              "eq": [
                "$task.directory",
                "$task_directory"
              ]
            }
          ]
        },
        {
          "code": "duplicate_running_worker",
          "message": "Close the running worker of this name before starting another.",
          "none": [
            {
              "linked": {
                "from": "$task",
                "link": "worker_runs",
                "where": {
                  "all": [
                    {
                      "eq": [
                        "name",
                        "$name"
                      ]
                    },
                    {
                      "eq": [
                        "status",
                        "running"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
