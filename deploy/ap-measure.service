[Unit]
Description=ap measure: the sessions pass and then the KPI pass (one run a night)
Documentation=https://github.com/park-kyungchan/agent-platform/blob/main/deploy/README.md

[Service]
Type=oneshot
# A failed sessions pass (the `-` prefix) does not keep the KPI pass of that night from running.
ExecStart=-/usr/local/bin/ap measure sessions
ExecStart=/usr/local/bin/ap measure kpis
# The sessions pass reads three days of session records and the KPI pass asks three functions of the store.
TimeoutStartSec=3600
Slice=agents.slice
Nice=10
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
