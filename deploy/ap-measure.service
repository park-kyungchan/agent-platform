[Unit]
Description=ap measure: the sessions pass, the KPI pass and then the routing pass (one run a night)
Documentation=https://github.com/park-kyungchan/lifecycle-platform/blob/main/deploy/README.md

[Service]
Type=oneshot
# A failed sessions or KPI pass (the `-` prefix) does not keep the passes after it that night from running.
ExecStart=-/usr/local/bin/ap measure sessions
ExecStart=-/usr/local/bin/ap measure kpis
ExecStart=/usr/local/bin/ap measure routing
# The sessions pass reads three days of session records, the KPI pass asks three functions of the store and the
# routing pass asks flow by tier of each confirmed intent.
TimeoutStartSec=3600
Slice=agents.slice
Nice=10
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=ONT_ROLE=measure
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
