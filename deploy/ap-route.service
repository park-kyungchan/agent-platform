[Unit]
Description=ap route index: the sections and components the function route answers from (one run)
Documentation=https://github.com/park-kyungchan/lifecycle-platform/blob/main/deploy/README.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ap route index --prune --repository park-kyungchan/lifecycle-platform --instructions /root/.agents
# A run fetches one clone, reads its Markdown at origin/main and indexes two sources: well under a minute.
TimeoutStartSec=600
Slice=agents.slice
Nice=10
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=ONT_ROLE=route
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
