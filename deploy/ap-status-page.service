[Unit]
Description=ap status page: write ap status --page to the status page file
Documentation=https://github.com/park-kyungchan/agent-platform/blob/main/deploy/README.md

[Service]
Type=oneshot
Nice=10
TimeoutStartSec=1290
StateDirectory=agent-platform/status-page
StateDirectoryMode=0755
Environment=HOME=/root
ExecStart=/bin/sh -c '/usr/local/bin/ap status --page > /var/lib/agent-platform/status-page/status.txt.new || { rm -f /var/lib/agent-platform/status-page/status.txt.new; exit 1; }; mv -f /var/lib/agent-platform/status-page/status.txt.new /var/lib/agent-platform/status-page/status.txt'
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
