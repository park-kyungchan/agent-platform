[Unit]
Description=ap clause index: the numbered sentences of the specifications the function clause answers from (one run)
Documentation=https://github.com/park-kyungchan/agent-platform/blob/main/deploy/README.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ap clause index --prune --repository park-kyungchan/agent-platform --repository park-kyungchan/ontology-platform --repository park-kyungchan/agent-vps-operations
# A run fetches three clones, reads their files at origin/main and indexes one source: well under a minute.
TimeoutStartSec=600
Slice=agents.slice
Nice=10
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
