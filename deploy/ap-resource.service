[Unit]
Description=ap resource: one pass that observes the hosts and accounts and indexes the samples and the checks
Documentation=https://github.com/park-kyungchan/lifecycle-platform/blob/main/specs/ap/resource.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ap resource
# A pass makes one ping and one probe of the PC (at most 42 seconds), the store's calls bound to 30 seconds each
# and one index of two sources.
TimeoutStartSec=180
# No Slice=: the pass reads the load of the slice the units run in from outside it.
Nice=10
Environment=HOME=/root
# sshd is in /usr/sbin.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ONT_ROLE=measure
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectSystem=full
