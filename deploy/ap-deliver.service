[Unit]
Description=ap deliver: install the accepted tip of lifecycle-platform (ap and the shared instructions)
Documentation=https://github.com/park-kyungchan/lifecycle-platform/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ap deliver
StandardInput=file:/etc/agent-platform/deliver.json
StandardOutput=journal
Slice=agents.slice
Nice=10
TimeoutStartSec=3600
SuccessExitStatus=2
# cargo is the rustup proxy, which reads its toolchains under HOME; a system service without User= has none.
Environment=HOME=/root
Environment=ONT_ROLE=deliver
# Confinement (specs/ap/deliver.md R52). No ProtectSystem=: delivery writes /usr/local/bin (ap) and
# the unit files of deploy/ under AP_UNIT_DIR (/etc/systemd/system).
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
