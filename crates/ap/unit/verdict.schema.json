{"type": "object", "additionalProperties": false, "required": ["verdict", "head", "blocking", "notes"],
 "properties": {
  "verdict": {"enum": ["accept", "repair"]},
  "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "blocking": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false,
    "required": ["id", "kind", "path", "line", "claim", "shown_by"],
    "properties": {
     "id": {"type": "string", "pattern": "^B[0-9]{1,2}$"},
     "kind": {"type": "integer", "minimum": 1, "maximum": 99},
     "path": {"type": "string", "minLength": 1},
     "line": {"type": "integer", "minimum": 0},
     "claim": {"type": "string", "minLength": 1},
     "shown_by": {"type": "string", "minLength": 1}}}},
  "notes": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false,
    "required": ["id", "text"],
    "properties": {"id": {"type": "string", "pattern": "^N[0-9]$"}, "text": {"type": "string", "minLength": 1}}}}}}
