{
  "contract_version": 1,
  "cases": [
    {
      "id": "additive-install-help",
      "args": [
        "install",
        "--help"
      ],
      "stdin": "",
      "expected": {
        "exit": 0,
        "stdout": "Usage: ap install plan|apply|recover < request.json\nap doctor inspect < spec.json\nExplicit Linux profiles/source; disposable or externally coordinated writers.\nNo hook execution; native loading requires separate evidence.\n",
        "stderr": ""
      }
    },
    {
      "id": "install-plan-invalid-json",
      "args": [
        "install",
        "plan"
      ],
      "stdin": "{",
      "expected": {
        "exit": 2,
        "stdout": "",
        "stderr": "{\"error\":{\"code\":\"invalid_input\",\"field\":\"stdin\"}}\n"
      }
    },
    {
      "id": "install-plan-unknown-fields",
      "args": [
        "install",
        "plan"
      ],
      "stdin": "{\"extra\":true}",
      "expected": {
        "exit": 2,
        "stdout": "",
        "stderr": "{\"error\":{\"code\":\"invalid_input\",\"field\":\"stdin\"}}\n"
      }
    },
    {
      "id": "install-plan-null-input",
      "args": [
        "install",
        "plan"
      ],
      "stdin": "null",
      "expected": {
        "exit": 2,
        "stdout": "",
        "stderr": "{\"error\":{\"code\":\"invalid_input\",\"field\":\"stdin\"}}\n"
      }
    },
    {
      "id": "install-plan-two-documents",
      "args": [
        "install",
        "plan"
      ],
      "stdin": "{}{}",
      "expected": {
        "exit": 2,
        "stdout": "",
