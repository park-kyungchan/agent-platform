{
  "name": "Fixture main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"exclude": [], "include": ["refs/heads/main"]}},
  "rules": [
    {"type": "deletion"},
    {"type": "pull_request", "parameters": {"required_approving_review_count": 0, "allowed_merge_methods": ["merge"]}},
    {"type": "required_status_checks", "parameters": {"strict_required_status_checks_policy": true, "required_status_checks": [{"context": "fixture-check"}]}}
  ],
  "bypass_actors": []
}
